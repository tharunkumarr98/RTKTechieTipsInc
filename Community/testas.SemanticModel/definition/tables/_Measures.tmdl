table _Measures
	lineageTag: 629b0039-6689-4f78-a09c-dd6e07855a85

	measure _EUR = ```
			
			VAR Use_SAS = SELECTEDVALUE(Table_SAS_MOK[Matas]) = "SAS"        -- eil. 1: ar pasirinkta „SAS“
			
			VAR Combined_Result =
			    SUMX(
			        I03_DKD,                                               -- eil. 3: iteruojam per visus įrašus
			        VAR sign = IF(I03_DKD[D_or_C] = "D", 1, -1)             -- eil. 4: debetas = +1, kreditas = -1
			        VAR balanceType =                                     -- eil. 5: gaunam Bal_1 iš atitinkamos lentelės
			            IF(
			                Use_SAS,                                      -- eil. 6: jei SAS
			                RELATED(N71_ACCM[Bal_1]),                     -- eil. 7: imti iš N71_ACCM
			                RELATED(N01_ACCT[Bal_1])                      -- eil. 8: kitaip – iš N01_ACCT
			            )
			        VAR factor = IF(balanceType = "A. Turtas", 1, -1)      -- eil. 9: „A. Turtas“ = +1, kiti = -1
			        RETURN
			            sign * factor * I03_DKD[I03_SUMA]                 -- eil. 10: galutinis įrašo indėlis
			    )
			
			RETURN
			    Combined_Result                                        -- eil. 12: grąžinam rezultatą vienu SUMX užėjimu
			
			
			```
		displayFolder: Balansas
		lineageTag: 9405819f-f984-4a92-bcd6-85c1ee5714e4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _EUR_cumulative = ```
			
			CALCULATE(
			    [_EUR],
			    '__Calendar'[Date] <= MAX('__Calendar'[Date])
			
			)
			
			```
		displayFolder: Balansas
		lineageTag: 3ea20e34-e797-4a70-bc0b-5fdff50dd95e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _EUR_RecalcByRate =
			// Full optimized measure avoiding non-constant DIVIDE alternate
			SUMX(                                                      -- line 1: iterate per currency code
			    ADDCOLUMNS(                                            -- line 2: build table with pre-computed values
			        VALUES( I03_DKD[N01_ACCT.N01_KODAS_VL] ),            -- line 3: one row per distinct currency code
			        "Bal", [_VAL_cumulative],             -- line 4: compute balance once per code
			        "Rate", [_currency_rate]     -- line 5: compute last currency rate once per code
			    ),                                                     -- line 6: end ADDCOLUMNS
			
			    VAR Bal = [Bal]                                        -- line 7: store balance in variable
			    VAR Rate = [Rate]                                      -- line 8: store rate in variable
			    VAR DivResult =                                         -- line 10: safe division, alternate = 0 (must be constant)
			    DIVIDE( Bal, Rate, 0 ) RETURN                                                 -- line 9: return expression for each row
			    IF(                                                -- line 10: if-rate-zero-or-blank test
			        OR(                                           -- line 11: test for blank or zero
			            ISBLANK( Rate ),
			            Rate = 0
			        ),
			        Bal,                                          -- line 12: if no valid rate, return balance
			        DivResult                             -- line 13: else, perform division
			    )                                                 -- line 14: end IF
			
			)                                                          -- line 15: end SUMX
		displayFolder: Balansas
		lineageTag: ede60179-050e-45df-b98d-6a4bef3d4e50

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _currency_rate = ```
			
			VAR CurrentDate = MAX('__Calendar'[Date])  -- Get the current date from the calendar
			VAR CurrentCode = MAX(I03_DKD[N01_ACCT.N01_KODAS_VL])  -- Get the current currency code
			VAR MaxRubDate =
			    CALCULATE(
			        MAX(PP_Currency_rate[date]),
			        PP_Currency_rate[name_2] = "RUB"
			    )
			
			RETURN 
			
			SWITCH(
			    TRUE(),
			    CurrentCode = "LIT", 3.4528,
			    CurrentCode = "RUB" && MaxRubDate <= CurrentDate, // imam paskutini pasiekiama kursa jei nera tinkamo
			        CALCULATE(
			            MAX(PP_Currency_rate[amount_2]),
			            PP_Currency_rate[name_2] = "RUB" && PP_Currency_rate[date] = MaxRubDate
			
			        )    
			    ,CurrentCode = "USDT", CALCULATE(
			        MAX(PP_Currency_rate[amount_2]),
			        PP_Currency_rate[name_2] = "USD" && PP_Currency_rate[date] = CurrentDate
			    )
			    ,CALCULATE(
			        MAX(PP_Currency_rate[amount_2]),
			        PP_Currency_rate[name_2] = CurrentCode && PP_Currency_rate[date] = CurrentDate
			    )
			)
			
			```
		displayFolder: Balansas
		lineageTag: c17e50d7-1d12-4156-8913-3620b70c5ca6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _VAL = ```
			
			VAR Use_SAS = SELECTEDVALUE(Table_SAS_MOK[Matas]) = "SAS"        -- eil. 1: ar pasirinkta „SAS“
			
			VAR Combined_Result =
			    SUMX(
			        I03_DKD,                                               -- eil. 3: iteruojam per visus įrašus
			        VAR sign = IF(I03_DKD[D_or_C] = "D", 1, -1)             -- eil. 4: debetas = +1, kreditas = -1
			        VAR balanceType =                                     -- eil. 5: gaunam Bal_1 iš atitinkamos lentelės
			            IF(
			                Use_SAS,                                      -- eil. 6: jei SAS
			                RELATED(N71_ACCM[Bal_1]),                     -- eil. 7: imti iš N71_ACCM
			                RELATED(N01_ACCT[Bal_1])                      -- eil. 8: kitaip – iš N01_ACCT
			            )
			        VAR factor = IF(balanceType = "A. Turtas", 1, -1)      -- eil. 9: „A. Turtas“ = +1, kiti = -1
			        RETURN
			            sign * factor * I03_DKD[_Suma_VAL]                 -- eil. 10: galutinis įrašo indėlis
			    )
			
			RETURN
			    Combined_Result                                        -- eil. 12: grąžinam rezultatą vienu SUMX užėjimu
			
			
			```
