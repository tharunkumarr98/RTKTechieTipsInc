	measure 'FX Rate Daily' = ```
			
			
			VAR DepthMode =
			    SELECTEDVALUE( CurrencyDepth[Depth], "Daily" )
			
			VAR SelectedDateFromSlicer = MAX(__Calendar[Date]) 
			    //SELECTEDVALUE( '__Calendar'[Date], TODAY() )
			
			
			
			VAR ContextDate =
			    MAX( I03_DKD[I02_OP_DATA.1] )
			
			
			VAR ClampedDate =
			IF(NOT(ISBLANK(ContextDate)) ,
			    IF(
			        SelectedDateFromSlicer > TODAY()  ,
			        TODAY(),
			        SelectedDateFromSlicer
			    ), BLANK()) 
			
			VAR LookupDate =
			    SWITCH(
			        TRUE(),
			        DepthMode = "Daily",          ContextDate,
			        DepthMode = "MonthEnd",       EOMONTH( ContextDate, 0 ),
			        DepthMode = "SelectedEndDate", ClampedDate
			    )
			
			VAR CurrentCode =
			    SELECTEDVALUE( I03_DKD[N01_ACCT.N01_KODAS_VL] )
			
			VAR RateTable =
			    FILTER(
			        ALL( PP_Currency_rate ),
			        PP_Currency_rate[name_2]    = CurrentCode
			            && PP_Currency_rate[date] <= LookupDate
			    )
			
			VAR LastRateDate =
			    MAXX( RateTable, PP_Currency_rate[date] )
			
			VAR LastRateValue =
			    CALCULATE(
			        MAX( PP_Currency_rate[amount_2] ),
			        PP_Currency_rate[date] = LastRateDate
			    )
			
			RETURN LastRateDate           
			// IF(
			//     ISINSCOPE( I03_DKD[N01_ACCT.N01_KODAS_VL] ),
			//     LastRateValue,
			//     BLANK()
			// ) 
			
			
			```
		formatString: General Date
		displayFolder: Balansas
		lineageTag: fd30d0cd-0ea8-47d6-8d59-3a7d802a18f8

	measure RowDateFact = ```
			
			VAR FactDate = MAX( I03_DKD[I02_OP_DATA.1] )
			VAR CalDate =
			    CALCULATE(
			      MAX( __Calendar[Date] ),
			      CROSSFILTER( __Calendar[Date], I03_DKD[I02_OP_DATA.1], BOTH )
			    )
			RETURN
			    IF(
			      NOT ISBLANK( FactDate ),
			      FactDate,
			      CalDate
			    )
			
			```
		formatString: General Date
		displayFolder: Balansas
		lineageTag: 9a608ad8-4168-4f59-8b74-79b1cf60054c

