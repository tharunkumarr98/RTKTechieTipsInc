expression fn_RunAPI_Call =
		let
		    Source = (PrefixParameters as text, symbol as text, SuffixParameters as text , query as record )=>
		let
		    Source = Json.Document(Web.Contents("https://financialmodelingprep.com/api/", [RelativePath = PrefixParameters & symbol & SuffixParameters , Query = query   ]  ))
		in
		    Source
		in
		    Source
