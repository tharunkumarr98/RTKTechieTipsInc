expression indicators = ```
		let
		    Source = historialData,
		    #"Grouped Rows" = Table.Group(Source, {"symbol"}, {{"AllRows", each _, type table [symbol=nullable text, date=nullable date, open=nullable number, high=nullable number, low=nullable number, close=nullable number, adjClose=nullable number, volume=nullable number, unadjustedVolume=nullable number, change=nullable number, changePercent=nullable number, vwap=nullable number, label=nullable date, changeOverTime=nullable number]}}),
		    Added52WeekHigh = Table.AddColumn(#"Grouped Rows", "52WeekHigh", each List.Max([AllRows][high]), type number),
		    Added52WeekLow = Table.AddColumn(Added52WeekHigh, "52WeekLow", each List.Min([AllRows][low]), type number),
		    AddedCloseChangeVwap = Table.AddColumn(Added52WeekLow, "CloseChangeVwap", each let 
		__table = Table.Max([AllRows],"date"),
		__change = __table[change],
		__close = __table[close],
		__vwap = if __table[vwap] < __close then "Buy" else "Sell"
		in 
		[change=__change ,close=__close,vwap=__vwap]),
		    ExpandedCloseChangeVwap = Table.ExpandRecordColumn(AddedCloseChangeVwap, "CloseChangeVwap", {"close", "change","vwap"}),
		    AddedSuperTrend = Table.AddColumn(ExpandedCloseChangeVwap, "st", each let 
		__TR = [52WeekHigh] - [52WeekLow],
		__Mutiplier3 = 3,
		__UpperBand = (([52WeekHigh]+[52WeekLow])/2) + (__Mutiplier3 * __TR),
		__LowerBand = (([52WeekHigh]+[52WeekLow])/2) - (__Mutiplier3 * __TR),
		__Result = if [close] < __UpperBand and [close] > __LowerBand then "Buy"  else "Sell"
		in 
		__Result, type text),
		    AddedRSI = Table.AddColumn(AddedSuperTrend, "rsi", each let 
		rsi = fn_RunAPI_Call("/v3/technical_indicator/1day/",[symbol],"",[type="rsi",period="14",apikey =apiKey]){0}[rsi],
		result = if rsi < 30 then "Buy" else if rsi > 70 then "Sell" else "Hold"
		in 
		result, type text),
		    AddedAiTrend = Table.AddColumn(AddedRSI, "AI", each [rsi], type text),
		    AddedEMA = Table.AddColumn(AddedAiTrend, "EMA", each let 
		EMA20 = try fn_RunAPI_Call("/v3/technical_indicator/1day/",[symbol],"",[type="ema",period="20",apikey =apiKey]){0}[ema] otherwise 0,
		EMA50 = try fn_RunAPI_Call("/v3/technical_indicator/1day/",[symbol],"",[type="ema",period="50",apikey =apiKey]){0}[ema] otherwise 0,
		EMA100 = try  fn_RunAPI_Call("/v3/technical_indicator/1day/",[symbol],"",[type="ema",period="100",apikey =apiKey]){0}[ema] otherwise 0,
		EMA200 = try fn_RunAPI_Call("/v3/technical_indicator/1day/",[symbol],"",[type="ema",period="200",apikey =apiKey]){0}[ema] otherwise 0,
		Result = if [close] > List.Max({EMA20, EMA50,  EMA100, EMA200}) then "Buy" else if [close] < List.Min({EMA20, EMA50,  EMA100, EMA200}) then "Sell" else "Hold"
		in 
		[EMA=Result, EMA20 = EMA20]),
		    #"Expanded EMA" = Table.ExpandRecordColumn(AddedEMA, "EMA", {"EMA", "EMA20"}, {"EMA", "EMA20"}),
		    #"AddedBollinger Bands" = Table.AddColumn(#"Expanded EMA", "Bollinger Bands", each let
		sd = fn_RunAPI_Call("/v3/technical_indicator/1day/",[symbol],"",[type="standardDeviation",period="20",apikey =apiKey]){0}[standardDeviation],
		ema = [EMA20],
		__Upperband = ema + ( 2 * sd),
		__LowerBand = ema - ( 2 * sd)
		in 
		if [close] > __Upperband then "Buy" else if [close] < __LowerBand then "Sell" else "Hold"),
		    RemovedUnesessaryColumns = Table.RemoveColumns(#"AddedBollinger Bands",{"AllRows","EMA20"}),
		    #"Changed Type" = Table.TransformColumnTypes(RemovedUnesessaryColumns,{{"symbol", type text}, {"52WeekHigh", type number}, {"52WeekLow", type number}, {"close", type number}, {"change", type number}, {"vwap", type text}, {"st", type text}, {"rsi", type text}, {"AI", type text}, {"EMA", type text}, {"Bollinger Bands", type text}})
		in
		    #"Changed Type"
		```
