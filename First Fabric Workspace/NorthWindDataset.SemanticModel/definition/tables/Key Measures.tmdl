		lineageTag: 347b9178-ce21-445f-b12f-791ba7050bd8

	measure 'Mexico LY YTD SalesAmount' = Calculate([SalesAmount], DATESYTD(SAMEPERIODLASTYEAR('Date'[Date])), Orders[ShipCountry] = "Mexico")
