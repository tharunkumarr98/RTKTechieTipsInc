table 'Key Measures'
	lineageTag: ddae6bd8-b723-48d0-a1dc-098381ad15b1

	measure SalesAmount = ```
			SUM(Orders[Freight]) 
			```
		lineageTag: eb29aaaf-90ac-4d3a-92fc-7488af6d6fd8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mexico YTD SalesAmount' = Calculate([SalesAmount], DATESYTD('Date'[Date]), Orders[ShipCountry] = "Mexico")
		displayFolder: Mexico
		lineageTag: d46e4f66-1df9-4277-9e2c-047ce3b19b3c

	measure 'Mexico LY SalesAmount' = Calculate([SalesAmount], Dateadd('Date'[Date],-1,Year), Orders[ShipCountry] = "Mexico")
