/// This semantic model contains AdventureWorks sales transactions from 2010 to 2014, integrating both internet and reseller sales. Its objective is to enable descriptive analytics across sales channels, empowering users to explore revenue, profit, order trends, and more. The model includes detailed information on products, customers, and employees, supporting segmentation and operational analysis. Suitable for building intuitive dashboards, the model helps business users uncover insights into sales performance, customer behavior, and product trends, driving informed decision-making for AdventureWorks stakeholders.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 0

queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup DataSourceParameters

	annotation PBI_QueryGroupOrder = 2

annotation PBI_QueryOrder = ["DimDate","DimProduct","DimEmployee","DimCustomer","FactInternetSales","Hostname","DatabaseName","KeyMeasuresTable","KPIName","FactResellerSales","RangeStart","RangeEnd"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.146.1454.0 (25.08)+901d6c338d1dea81ac3e53073ffb10469f0f37b8

annotation PBI_ProTooling = ["DaxQueryView_Desktop","TMDLView_Desktop"]

ref table DimProduct
ref table DimEmployee
ref table DimCustomer
ref table FactInternetSales
ref table DimDate
ref table KeyMeasuresTable
ref table FactResellerSales
ref table TrendParameter
ref table KPIParameter
ref table KPIName

ref cultureInfo en-US

