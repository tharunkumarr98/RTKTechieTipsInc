	partition DimProduct = m
		mode: import
		queryGroup: Dimensions
		source = ```
				let
				    Source = Sql.Database(Hostname, DatabaseName, [Query="Select [ProductKey],
							[ProductAlternateKey],
							s.[ProductSubcategoryKey],
							[WeightUnitMeasureCode],
							[SizeUnitMeasureCode],
							[EnglishProductName],
							[StandardCost],
							[FinishedGoodsFlag],
							[Color],
							[SafetyStockLevel],
							[ReorderPoint],
							[ListPrice],
							[Size],
							[SizeRange],
							[Weight],
							[DaysToManufacture],
							[ProductLine],
							[DealerPrice],
							[Class],
							[Style],
							[ModelName],
							[EnglishDescription],
							[StartDate],
							[EndDate],
							[Status],
							[EnglishProductSubcategoryName],
							[EnglishProductCategoryName]
				FROM [AdventureWorks_Lakehouse].[dbo].[dimproduct] p
				JOIN [AdventureWorks_Lakehouse].[dbo].[dimproductsubcategory] s on 
				p.ProductSubcategoryKey = s.ProductSubcategoryKey join
				[AdventureWorks_Lakehouse].[dbo].[dimproductcategory] c on 
				s.[ProductCategoryKey] = c.[ProductCategoryKey]"])
				in
				    Source
				```

