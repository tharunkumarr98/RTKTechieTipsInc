function ANSCIICharacters =
		(CharacterName: string) =>
				VAR __Character = SWITCH(
					CharacterName,
					//Other
					"Line Break", UNICHAR(10),
					"Non Printable space", UNICHAR(32),
					"Printable Space", UNICHAR(127),
					//Symbols
					"Upward Triangle", "▼",
					"Downward Triangle", "▼",
					"Upward Arrow", "↑",
					"Downward Arrow", "↓",
					"Left Arrow", "←",
					"Left Arrow", "→",
					"Tick Mark", "✓",
					"Cross Mark", "✕",
					"Upward CHEVRON", "˄",
					"Downard CHEVRON", "˅",
					"Cross Mark", "✕",
		
					//Colored Cirles
					"Red Circle", "🔴",
					"Blue Circle", "🔵",
					"Green Circle", "🟢",
					"Yellow Circle", "🟡",
					"Black Circle", "⚫",
					"Purple Circle", "🟣",
					"Orange Circle", "🟠",
		
					//Currencies
					"Chinese Yuan", "¥",
					"Europe Euro", "€",
					"Indian Rupee", "₹",
					"Japanese Yen", "¥"
				)
				RETURN
					__Character
	lineageTag: 956bd739-7586-4bc2-9974-cf3fa550d969

function ConvertSecondsToMinutes =
		(Seconds:int64, WithSymbols:boolean)=>
				VAR __Minutes =ROUNDDOWN(DIVIDE(Seconds, 60),0)
				VAR __Seconds = MOD(Seconds, 60)
				VAR __WithSymbols = __Minutes & "m:" & __Seconds & "s"
				VAR __WithoutSymbols= FORMAT(__Minutes,"00") & ":" & FORMAT( __Seconds,"00")
				RETURN IF(WithSymbols, __WithSymbols, __WithoutSymbols)
	lineageTag: b29c3046-33b3-4227-b8cf-8efdf244e725

function ConvertSecondsToHours =
		(Seconds:int64, WithSymbols:boolean)=>
				VAR __Hours = ROUNDDOWN(DIVIDE(Seconds, 3600),0)
				VAR __RemainingSeconds = Seconds - __Hours*3600
				VAR __MinutesWithSymbols = ConvertSecondsToMinutes(__RemainingSeconds,TRUE())
				VAR __MinutesWithOutSymbols = ConvertSecondsToMinutes(__RemainingSeconds, FALSE())
				VAR __WithSymbols = __Hours & "h:" & __MinutesWithSymbols
				VAR __WithOutSymbols = FORMAT( __Hours,"00") & ":" & __MinutesWithOutSymbols
				RETURN IF(WithSymbols, __WithSymbols, __WithOutSymbols)
	lineageTag: db4b4c3a-0862-44d7-a7b7-109ce7296da5

function ConvertSecondsToDays =
		(Seconds:int64, WithSymbols:boolean)=>
				VAR __Days = ROUNDDOWN(DIVIDE(Seconds, 86400),0)
				VAR __RemainingSeconds = Seconds - __Days * 86400
				VAR __HoursWithSymbols = ConvertSecondsToHours(__RemainingSeconds,TRUE())
				VAR __HoursWithOutSymbols = ConvertSecondsToHours(__RemainingSeconds, FALSE())
				VAR __WithSymbols = __Days & "d:" & __HoursWithSymbols
				VAR __WithOutSymbols = FORMAT( __Days,"00") & ":" & __HoursWithOutSymbols
				RETURN IF(WithSymbols, __WithSymbols, __WithOutSymbols)
	lineageTag: 52d489bb-b0dc-4ae0-a457-0324ee250206

function getDynamicFormatString =
		(Val: anyref, numberOfDecimalPlaces: numeric, thousandSeperator: boolean, multiplesOfThousand: boolean, negativeNumbersBracket: boolean, truncateZero:boolean, deltaIcon: boolean) =>
				VAR __AbsVal = ABS(Val)
				VAR __decimalPart = IF(
					numberOfDecimalPlaces > 0,
					"." & REPT(
						"0",
						numberOfDecimalPlaces
					),
					""
				)
				VAR __MultiplesOfThousand = IF(
					multiplesOfThousand,
					SWITCH(
						TRUE(),
						__AbsVal >= 1e12, ",,,," & __decimalPart & "T",
						__AbsVal >= 1e9, ",,," & __decimalPart & "B",
						__AbsVal >= 1e6, ",," & __decimalPart & "M",
						__AbsVal >= 1e3, "," & __decimalPart & "K",
						"" & __decimalPart
					),
					"" & __decimalPart
				)
				VAR __DigitWithThousandSeperator = "#,0"
				VAR __DigitWithoutThousandSeperator = "0"
				VAR __NumericFormatString = IF(
					thousandSeperator,
					__DigitWithThousandSeperator & __MultiplesOfThousand,
					__DigitWithoutThousandSeperator & __MultiplesOfThousand
				)
				VAR __PositiveFormatString = __NumericFormatString & IF(
					deltaIcon,
					"▲",
					""
				)
		
				VAR __NegativeFormatString = IF(
					negativeNumbersBracket,
					";(" & __NumericFormatString & ")",
					";-" & __NumericFormatString
				) & IF(
					deltaIcon,
					"▼"
				)
				VAR __FormatString = __PositiveFormatString & __NegativeFormatString & IF(truncateZero, ";0","")
				RETURN
					__FormatString
	lineageTag: 952c0607-0c8d-4793-8230-65a51c03bba1

