model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup DataSourceParamters

	annotation PBI_QueryGroupOrder = 0

queryGroup DimTables

	annotation PBI_QueryGroupOrder = 1

queryGroup FactTables

	annotation PBI_QueryGroupOrder = 2

queryGroup InDatasetTables

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["TMDLView_Desktop","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["DimDateTable","DimSeriesNames","KeyMeasuresTable","HostName","DatabaseName","FactFredData","DimDateTable2 (Disconnected)"]

annotation __TEdtr = 1

ref table DimDateTable
ref table KeyMeasuresTable
ref table FactFredData
ref table DimSeriesNames
ref table 'DimDateTable2 (Disconnected)'

ref cultureInfo en-US

