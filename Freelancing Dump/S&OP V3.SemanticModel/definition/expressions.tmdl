		else if [Seven_Master.Source_Plant] = "Valencia" then "Valencia - Spain"
		else if [Seven_Master.State] = "Frozen" and ([Plant] = "LPIA" or [Plant] = "LPPA") then [Seven_Master.Source_Plant] else if [Seven_Master.State] = "Frozen" and [Plant] ="CNGB" then "Cina FRZ"
		else if [Seven_Master.State] = "Frozen" and [Plant] = "LPBA" then "Arlon FRZ"
		else if [Plant] = "LPIA" or [Plant] = "LPIC" or [Plant] = "LPPA" or [Plant] = "TRGB" or [Plant] = "INPB" or [Plant] = "LPDA" or [Plant] = "LPBA" or [Plant] = "CNGB" or [Plant] = "RUD1" or [Plant] = "RUE1" or [Plant] = "LUD0" or [Plant] = "LPID" then [Plant_Desc.Description]
		else if [Plant] = "LUTB" or [Plant] = "LIKW" or [Plant] = "LIAE" or [Plant] = "LISA" then 
		    if [#"Seven_Master.Brand (Sub-Class Desc.)"] = "Nutella" then "FERRERO TURKIYE CIKOLATA VE TA"
		    else "Ferrero India - Baramati Plant"
