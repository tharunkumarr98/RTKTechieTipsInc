		    #"Renamed Columns3" = Table.RenameColumns(#"Changed Type8",{{"Act_Indust_Gate_Out_Weighted ", "Act_Indust_Gate_Out_Weighted"}}),
		    #"Added Custom9" = Table.AddColumn(#"Renamed Columns3", "Container_Conc", each [Material]&[Batch]&[Transit_Time.Data.Country]),
