		    #"Added Custom2" = Table.AddColumn(#"Expanded Transit_Time1", "Estimated ETA (Week)", each if [Transit_Time.Data.Transit_Time] + [Week of Year] > 52 then 0 + ([Transit_Time.Data.Transit_Time] - (52 - [Week of Year])) else [Transit_Time.Data.Transit_Time] + [Week of Year]),
		    #"Changed Type10" = Table.TransformColumnTypes(#"Added Custom2",{{"Estimated ETA (Week)", type number}}),
		    #"Renamed Columns2" = Table.RenameColumns(#"Changed Type10",{{"Transit_Time.Data.Transit_Time", "Data.Transit_Time"}}),
