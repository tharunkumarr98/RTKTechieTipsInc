		    #"Split Column by Delimiter" = Table.SplitColumn(#"Duplicated Column", "Source.Name - Copy", Splitter.SplitTextByDelimiter(" ", QuoteStyle.Csv), {"Source.Name - Copy.1", "Source.Name - Copy.2", "Source.Name - Copy.3"}),
		    #"Changed Type12" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"Source.Name - Copy.1", type text}, {"Source.Name - Copy.2", type text}, {"Source.Name - Copy.3", type text}}),
		    #"Removed Columns" = Table.RemoveColumns(#"Changed Type12",{"Source.Name - Copy.1", "Source.Name - Copy.2"}),
		    #"Split Column by Delimiter1" = Table.SplitColumn(#"Removed Columns", "Source.Name - Copy.3", Splitter.SplitTextByDelimiter(".", QuoteStyle.Csv), {"Source.Name - Copy.3.1", "Source.Name - Copy.3.2"}),
		    #"Changed Type13" = Table.TransformColumnTypes(#"Split Column by Delimiter1",{{"Source.Name - Copy.3.1", Int64.Type}, {"Source.Name - Copy.3.2", type text}}),
		    #"Removed Columns1" = Table.RemoveColumns(#"Changed Type13",{"Source.Name - Copy.3.2"}),
		    #"Renamed Columns5" = Table.RenameColumns(#"Removed Columns1",{{"Source.Name - Copy.3.1", "Yr"}}),
		    #"Changed Type14" = Table.TransformColumnTypes(#"Renamed Columns5",{{"Yr", type text}}),
		    #"Added Conditional Column" = Table.AddColumn(#"Changed Type14", "2324 Qtls", each if [Yr] = "2324" then [QL] else null),
		    #"Changed Type15" = Table.TransformColumnTypes(#"Added Conditional Column",{{"2324 Qtls", type number}}),
		    #"Added Conditional Column1" = Table.AddColumn(#"Changed Type15", "2425 Qtls", each if [Yr] = "2425" then [QL] else null),
		    #"Changed Type16" = Table.TransformColumnTypes(#"Added Conditional Column1",{{"2425 Qtls", type number}}),
		    #"Added Custom11" = Table.AddColumn(#"Changed Type16", "Volume CD3", each [Seven_Master.Vol]*[Delivery quantity]),
		    #"Changed Type17" = Table.TransformColumnTypes(#"Added Custom11",{{"Volume CD3", type number}}),
		    #"Added Custom12" = Table.AddColumn(#"Changed Type17", "Saturation Rule", each if 
		    [Shipment Plant] = "FERRERO TURKIYE CIKOLATA VE TA" or 
		    [Shipment Plant] = "Valencia - Spain" or 
		    [Shipment Plant] = "FTL Plant Arlon" or 
		    [Shipment Plant] = "Plant Hub Dubai" 
		then 
		    "Pallet" 
		else if 
		    [Total Weight] / 24000 > [Volume CD3] / 57000 
		then 
		    "Weight" 
		else 
		    "Volume"),
		    #"Changed Type18" = Table.TransformColumnTypes(#"Added Custom12",{{"Saturation Rule", type text}}),
		    #"Added Custom13" = Table.AddColumn(#"Changed Type18", "Container Saturation Lane", each if 
		    [Transit_Time.Data.Country] = "Dubai" and [Shipment Plant] = "Plant Hub Dubai" then 
		        1 
		else if 
		    [Shipment Plant] = "Plant Hub Dubai" then 
		        [#"Seven_Master.#Pallets"] / 26 
		else if 
		    [Saturation Rule] = "Pallet" and [Shipment Plant] = "FERRERO TURKIYE CIKOLATA VE TA" then 
		        [#"Seven_Master.#Pallets"] / 23 
		else if 
		    [Saturation Rule] = "Pallet" and [Shipment Plant] = "FTL Plant Arlon" then 
		        [#"Seven_Master.#Pallets"] / 40 
		else if 
		    [Saturation Rule] = "Pallet" and [Shipment Plant] = "Valencia - Spain" then 
		        [#"Seven_Master.#Pallets"] / 23 
		else if 
		    [Saturation Rule] = "Pallet" and 
		    ([Transit_Time.Data.Country] = "Qatar" or [Transit_Time.Data.Country] = "Bahrain") and 
		    [Seven_Master.State] = "Chilled" then 
		        [#"Seven_Master.#Pallets"] / 23 
		else if 
		    [Saturation Rule] = "Pallet" and 
		    ([Shipment Plant] = "FTL Plant Alba" or [Shipment Plant] = "FTL Plant Belsk") and 
		    [Seven_Master.State] = "Ambient" then 
		        [#"Seven_Master.#Pallets"] / 42 
		else if 
		    [Shipment Plant] = "Ferrero India - Baramati Plant" and [Saturation Rule] = "Pallet" then 
		        [#"Seven_Master.#Pallets"] / 42 
		else if 
		    [Shipment Plant] = "Ferrero OPS Cina FP" and [Saturation Rule] = "Pallet" then 
		        [#"Seven_Master.#Pallets"] / 20 
		else if 
		    ([Shipment Plant] = "FTL Plant Belsk" or [Shipment Plant] = "FTL Plant Stadtallendorf") and 
		    [Saturation Rule] = "Weight" then 
		        [Total Weight] / 21500 
		else if 
		    [Saturation Rule] = "Weight" then 
		        [Total Weight] / 24000 
		else if 
		    [Shipment Plant] = "FTL Plant Stadtallendorf" and [Saturation Rule] = "Volume" then 
		        [Volume CD3] / 57000 
		else if 
		    [Saturation Rule] = "Volume" then 
		        [Volume CD3] / 57000 
		else 
		    0),
		    #"Changed Type19" = Table.TransformColumnTypes(#"Added Custom13",{{"Container Saturation Lane", type number}}),
		    #"Added Custom14" = Table.AddColumn(#"Changed Type19", "Total Pallets", each [Delivery quantity]/[#"Seven_Master.#Pallets"]),
		    #"Changed Type21" = Table.TransformColumnTypes(#"Added Custom14",{{"Total Pallets", type number}, {"Delivery", type text}}),
		    #"Duplicated Column1" = Table.DuplicateColumn(#"Changed Type21", "Shipment Plant", "Shipment Plant - Copy"),
		    #"Renamed Columns7" = Table.RenameColumns(#"Duplicated Column1",{{"Shipment Plant - Copy", "Shipment Plant - Short"}}),
		    #"Changed Type22" = Table.TransformColumnTypes(#"Renamed Columns7",{{"Shipment Plant - Short", type text}}),
		    #"Replaced Value1" = Table.ReplaceValue(#"Changed Type22","FTL Plant S. Angelo","S.Angelo",Replacer.ReplaceText,{"Shipment Plant - Short"}),
		    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","FTL Plant Alba","Alba",Replacer.ReplaceText,{"Shipment Plant - Short"}),
		    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","FTL Plant Belsk","Belsk",Replacer.ReplaceText,{"Shipment Plant - Short"}),
		    #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value3","Plant Hub Dubai","Hub Dubai",Replacer.ReplaceText,{"Shipment Plant - Short"}),
		    #"Replaced Value5" = Table.ReplaceValue(#"Replaced Value4","Ferrero OPS Cina FP","Cina ",Replacer.ReplaceText,{"Shipment Plant - Short"}),
		    #"Replaced Value6" = Table.ReplaceValue(#"Replaced Value5","FERRERO BALVANO","Balvano",Replacer.ReplaceText,{"Shipment Plant - Short"}),
		    #"Replaced Value7" = Table.ReplaceValue(#"Replaced Value6","Ferrero India - Baramati Plant","Baramati",Replacer.ReplaceText,{"Shipment Plant - Short"}),
