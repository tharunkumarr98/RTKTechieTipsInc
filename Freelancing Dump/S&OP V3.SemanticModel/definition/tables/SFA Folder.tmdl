	measure Selection_Bias_CY_01 =
			
			
			
			if (SELECTEDVALUE('YrTable'[Value])="2425",
			
			if( SELECTEDVALUE(Month_Sort[Sort])>10, ---this is to remove from projection
			
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)])
			
			Var _TotalResult =  CALCULATE(DIVIDE(sum('SFA Folder'[2425 Forecast 01]), Sum('SFA Folder'[STD Digitalization.Net Weight (QL)]),0)*100, REMOVEFILTERS(Market))
			Var _PerMarketResult = DIVIDE(sum('SFA Folder'[2425 Forecast 01]), Sum('SFA Folder'[STD Digitalization.Net Weight (QL)]),0)*100
