	measure 'Total Consecutive months (Current Month)' = ```
			
			Var _CurrnetMonth = FORMAT( EOMONTH( TODAY(),-1) , "MMM") 
			Var Result = 
			MAXX(
			FILTER(
			SUMMARIZECOLUMNS(
			        'SFA Folder'[Commercial Ref.],
			        'SFA Folder'[SKU],
			        'SFA Folder'[Month_Sort.Sort],
			        'SFA Folder'[Mon],
			        "Consecutive Months", 
			       [Consecutive months (>100)]
			       ), 'SFA Folder'[Mon] = _CurrnetMonth),
			       [Consecutive Months]
			) 
			return Result   
			```
		formatString: 0
		lineageTag: 109bbc88-0090-4fdf-8005-72a35a401bb1

	measure 'Consecutive months (>100)' = ```
			
			 Var __CurrentMonth = MAX('SFA Folder'[Month_Sort.Sort]) 
			        Var __Bias = ABS( [Bias F4 and O4])
			        Var __lastprevoccurance = CALCULATE(MAX('SFA Folder'[Month_Sort.Sort]), FILTER(ALL('SFA Folder'), 'SFA Folder'[Month_Sort.Sort] <= __CurrentMonth && ABS( [Bias F4 and O4])  < 100 && 'SFA Folder'[Year] = "2425"), VALUES('SFA Folder'[SKU])) 
			        RETURN IF(__Bias >= 100, __CurrentMonth - __lastprevoccurance,0)  
			```
		formatString: 0
		lineageTag: 28bcf51c-64b6-43ed-ad02-16499b16a679

	measure 'Total Consecutive months' = ```
			
			MAXX(
			SUMMARIZECOLUMNS(
			        'SFA Folder'[Commercial Ref.],
			        'SFA Folder'[SKU],
			        'SFA Folder'[Month_Sort.Sort],
			        "Consecutive Months", 
			       [Consecutive months (>100)]
			       ),
			       [Consecutive Months]
			) 
			```
		formatString: 0
		lineageTag: cd449ebc-9df0-4d6a-80bc-00eafe5c3bc3

	measure 'Total Consecutive months V2 (Sum)' = ```
			
			SUMX(
			SUMMARIZECOLUMNS(
			        'SFA Folder'[Commercial Ref.],
			        'SFA Folder'[SKU],
			        'SFA Folder'[Month_Sort.Sort],
			        "Consecutive Months", 
			      IF( [Consecutive months (>100)] > 0, 1)
			       ),
			       [Consecutive Months]
			)
			```
		formatString: 0
		lineageTag: 1d901274-e677-4cb1-ad2e-6cb7c01c1a16

	measure 'Total Consecutive months V3 (latest max)' = ```
			
			MAXX(
			TOPN(1,
			SUMMARIZECOLUMNS(
			        'SFA Folder'[Commercial Ref.],
			        'SFA Folder'[SKU],
			        'SFA Folder'[Month_Sort.Sort],
			        "Consecutive Months", 
			      [Consecutive months (>100)] 
			       ),
			       'SFA Folder'[Month_Sort.Sort], DESC, [Consecutive Months], DESC 
			) ,
			[Consecutive Months]) 
			```
		formatString: 0
		lineageTag: 693f8639-7370-43c6-adcf-24c4a50bc8e2

	measure AbsBias =
			
			Var __Forecast = [Forecast 4 2425]
			Var __Order = [Order 4 2425]
			return ABS(IF( NOT(ISBLANK(__Order)) ,
			 __Forecast - __Order  ))
		lineageTag: f3b1983b-68bf-4504-818d-8a0f88fae3e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

