			RETURN IF(_SelectedMarket = "GAC (GULF)", _TotalResult,IF(_SelectedMarket = "Direct Market", _JVResult,_PerMarketResult))
			
			, ---------------------this is for remaining months (before future month projection)
			
			
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)]) -- this is for prev months
			
			Var _TotalResult =  CALCULATE(DIVIDE(sum('SFA Folder'[2425 Forecast 01]), Sum('SFA Folder'[2425 Order 01]),0)*100, REMOVEFILTERS(Market))
			
			Var _PerMarketResult = DIVIDE(sum('SFA Folder'[2425 Forecast 01]), Sum('SFA Folder'[2425 Order 01]),0)*100
