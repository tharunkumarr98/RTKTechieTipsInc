	measure 'SFA 04 2425' = ```
			
			
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)])
			Var _DirectMarketResult = 
			
			Var Result = 
			CALCULATE(
			        100 - 
			        IF (
			            SUM('SFA Folder'[2425 Abs 04]) >= SUM('SFA Folder'[2425 Order 04]),
			            100,
			            SUM('SFA Folder'[2425 Abs 04]) / SUM('SFA Folder'[2425 Order 04]) * 100
			        )
			 , Market[Market (Key)] IN {"Saudi Arabia", "Kuwait","Dubai"})
			
			 RETURN 
			        IF(Result = 0, BLANK(), Result)
			
			
			Var _TotalResult =
			
			  VAR Result =
			    CALCULATE(
			        100 - 
			        IF (
			            SUM('SFA Folder'[2425 Abs 04]) >= SUM('SFA Folder'[2425 Order 04]),
			            100,
			            SUM('SFA Folder'[2425 Abs 04]) / SUM('SFA Folder'[2425 Order 04]) * 100
			        )
			 , REMOVEFILTERS(Market))
			
			 RETURN 
			        IF(Result = 0, BLANK(), Result)
			
			Var _PerMarketResult = 
			
			    VAR Result = 
			        100 - 
			        IF (
			            SUM('SFA Folder'[2425 Abs 04]) >= SUM('SFA Folder'[2425 Order 04]),
			            100,
			            SUM('SFA Folder'[2425 Abs 04]) / SUM('SFA Folder'[2425 Order 04]) * 100
			        )
			    RETURN 
			        IF(Result = 0, BLANK(), Result)
			
			    RETURN   IF(_SelectedMarket = "GAC (GULF)",_TotalResult, if(_SelectedMarket="Direct Market",_DirectMarketResult,_TotalResult))
			
			
			```
