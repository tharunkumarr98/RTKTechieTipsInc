	measure 'SFA 01 2425' = ```
			
			
			--	SFA % on Order_CR = 100 – MAPE % on Order_CR, and MAPE % on Order_CR is:
			--  1. If Abs delta > = Order, then put 100 
			--	2. If Abs delta < Order , then calculation is Abs delta / Order * 100.
			
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)])
			
			Var _DirectMarketResult = 
			
			Var Result = 
			CALCULATE(
			        100 - 
			        IF (
			            SUM('SFA Folder'[2425 Abs 01]) >= SUM('SFA Folder'[2425 Order 01]),
			            100,
			            SUM('SFA Folder'[2425 Abs 01]) / SUM('SFA Folder'[2425 Order 01]) * 100
			        )
			 , Market[Market (Key)] IN {"Saudi Arabia", "Kuwait","Dubai"})
			
			 RETURN 
			        IF(Result = 0, BLANK(), Result)
			
			Var _TotalResult =
			
			  VAR Result =
			    CALCULATE(
			        100 - 
			        IF (
			            SUM('SFA Folder'[2425 Abs 01]) >= SUM('SFA Folder'[2425 Order 01]),
			            100,
			            SUM('SFA Folder'[2425 Abs 01]) / SUM('SFA Folder'[2425 Order 01]) * 100
			        )
			 , REMOVEFILTERS(Market))
			
			 RETURN 
			        IF(Result = 0, BLANK(), Result)
			
			Var _PerMarketResult = 
			
			    VAR Result = 
			        100 - 
			        IF (
			            SUM('SFA Folder'[2425 Abs 01]) >= SUM('SFA Folder'[2425 Order 01]),
			            100,
			            SUM('SFA Folder'[2425 Abs 01]) / SUM('SFA Folder'[2425 Order 01]) * 100
			        )
			    RETURN 
			        IF(Result = 0, BLANK(), Result)
			
			    RETURN IF(_SelectedMarket = "GAC (GULF)" ,_TotalResult,IF(_SelectedMarket = "Direct Market",_DirectMarketResult,_PerMarketResult))
			
			
			```
		lineageTag: 9fb6df7d-6775-4727-85c4-1f8cf80fdc2a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SFA 01 2324 Tot' = ```
			
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)])
			Var _TotalResult =  CALCULATE( IF (
			    SELECTEDVALUE(Month_Sort[Month]) = "LY",
			    
			    CALCULATE(
			        100 - IF (
			            SUM('SFA Folder'[2324 Abs 01]) >= SUM('SFA Folder'[2324 Order 01]),
			            100,
			            DIVIDE(SUM('SFA Folder'[2324 Abs 01]), SUM('SFA Folder'[2324 Order 01]), 0) * 100
			        ),
			        ALLSELECTED(Month_Sort) // This will retain the current filter context for other Month_Sort values
			    ),""
			)
			
			 , REMOVEFILTERS(Market))
			Var _PerMarketResult = 
			IF (
			    SELECTEDVALUE(Month_Sort[Month]) = "LY",
			    
			    CALCULATE(
			        100 - IF (
			            SUM('SFA Folder'[2324 Abs 01]) >= SUM('SFA Folder'[2324 Order 01]),
			            100,
			            DIVIDE(SUM('SFA Folder'[2324 Abs 01]), SUM('SFA Folder'[2324 Order 01]), 0) * 100
			        ),
			        ALLSELECTED(Month_Sort) // This will retain the current filter context for other Month_Sort values
			    ),""
			)
			RETURN IF(_SelectedMarket <> "GAC (GULF)",_PerMarketResult, _TotalResult)
			
			
			```
