table 'SFA Folder'
	lineageTag: 7b87b89a-5e2d-4967-80fe-2d5bbeca5834

	measure 'SFA 01 2324' = ```
			
			
			--	SFA % on Order_CR = 100 – MAPE % on Order_CR, and MAPE % on Order_CR is:
			--  1. If Abs delta > = Order, then put 100 
			--	2. If Abs delta < Order , then calculation is Abs delta / Order * 100.
			
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)])
			Var _TotalResult =  CALCULATE( IF (
			    SELECTEDVALUE('Month_Sort'[Month]) = "YTD" || SELECTEDVALUE('Month_Sort'[Month]) = "LY",
			    BLANK(),
			    100 - IF (
			        SUM('SFA Folder'[2324 Abs 01]) >= SUM('SFA Folder'[2324 Order 01]),
			        100,
			        SUM('SFA Folder'[2324 Abs 01]) / SUM('SFA Folder'[2324 Order 01]) * 100
			    )
			)
			 , REMOVEFILTERS(Market))
			Var _PerMarketResult = 
			IF (
			    SELECTEDVALUE('Month_Sort'[Month]) = "YTD" || SELECTEDVALUE('Month_Sort'[Month]) = "LY",
			    BLANK(),
			    100 - IF (
			        SUM('SFA Folder'[2324 Abs 01]) >= SUM('SFA Folder'[2324 Order 01]),
			        100,
			        SUM('SFA Folder'[2324 Abs 01]) / SUM('SFA Folder'[2324 Order 01]) * 100
			    )
			)
			RETURN IF(_SelectedMarket <> "GAC (GULF)",_PerMarketResult, _TotalResult)
			
			```
		lineageTag: 95bf39e9-40d0-40e3-96ee-c10613ab5d9b

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Bias 01 2324' = ```
			
			-- Bias = (Forecast Monday / Order)  * 100
			
			--if (SELECTEDVALUE('SFA Folder'[Year])="2324" || SELECTEDVALUE('SFA Folder'[Year])="2425" ,
			
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)])
			Var _TotalResult =  CALCULATE(DIVIDE(sum('SFA Folder'[2324 Forecast 01]), Sum('SFA Folder'[2324 Order 01]),0)*100, REMOVEFILTERS(Market))
			Var _PerMarketResult = DIVIDE(sum('SFA Folder'[2324 Forecast 01]), Sum('SFA Folder'[2324 Order 01]),0)*100
			RETURN IF(_SelectedMarket <> "GAC (GULF)",_PerMarketResult, _TotalResult)
			
			
			--,"")
			
			
			
			
			
