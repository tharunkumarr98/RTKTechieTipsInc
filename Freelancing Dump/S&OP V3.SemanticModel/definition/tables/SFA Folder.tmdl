	measure 'Bias 01 2425' = ```
			
			 
			 -- Bias = (Forecast Monday / Order)  * 100
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)])
			Var _TotalResult =  CALCULATE(DIVIDE('SFA Folder'[Selection_Forecast_01], Sum('SFA Folder'[2425 Order 01]),0)*100, REMOVEFILTERS(Market))
			Var _PerMarketResult =
			
			    DIVIDE(
			    'SFA Folder'[Selection_Forecast_01], Sum('SFA Folder'[2425 Order 01]),0)*100
			
			    RETURN IF(_SelectedMarket <> "GAC (GULF)",_PerMarketResult, _TotalResult)
			
			```
