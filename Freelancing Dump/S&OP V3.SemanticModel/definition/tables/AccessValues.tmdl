table AccessValues
	lineageTag: 5161c3c2-6b60-4b53-aa4b-0018802d56cc

	measure 'S&OP Current % difference from Bdgt1' =
			
			/*
			VAR __BASELINE_VALUE = [S&OP BDGT]
			VAR __VALUE_TO_COMPARE = [S&OP Current]
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__VALUE_TO_COMPARE,__BASELINE_VALUE)
				)
			*/
			
			    VAR __BASELINE_VALUE = [S&OP BDGT]
			VAR __VALUE_TO_COMPARE = [S&OP M0]
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__VALUE_TO_COMPARE - __BASELINE_VALUE, __BASELINE_VALUE)
				)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d7aa6b5b-9e88-4d1a-82d1-665ae5bba6d4

	measure 'S&OP MOM Delta' =
			
			CALCULATE(sum('STD S&OP NY (2526)'[FY])/1000,'STD S&OP NY (2526)'[Week]="28.2025")- CALCULATE(sum('STD S&OP NY (2526)'[FY])/1000,'STD S&OP NY (2526)'[Week]="24.2025")
		lineageTag: 1d1a03fb-281e-425b-9551-83ac9701864a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Access
		lineageTag: 68710837-5a0a-41ed-86fd-f3377888773e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Access]
		sortByColumn: ColOrder

		annotation SummarizationSetBy = Automatic

	column ColOrder
		formatString: 0
		lineageTag: bdccde61-d77b-4d96-b577-ebf451902560
		summarizeBy: sum
		isNameInferred
		sourceColumn: [ColOrder]

		annotation SummarizationSetBy = Automatic

	partition AccessValues = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "Access", STRING, "ColOrder", INTEGER,
				    {
				        {"YTD", 1},
				        {"M0-M4", 2},
				        {"YTG", 3},
				        {"FY Outlook", 4}
				        
				    }
				)
				
				```

	annotation PBI_Id = 03abb9cff351412ab13b4dd1b8d38e24

