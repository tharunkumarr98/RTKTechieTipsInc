		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OTIF_Waterfall_Detailed = ```
			
			IF (
			    SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Total", 
			    CALCULATE([Selected_Measure_OTIF_Qty],REMOVEFILTERS(OTIF[Breakdown (Combined)])),
			    IF (
			        SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Ramadan Cut off Time", 
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[Breakdown (Combined)]="Ramadan Cut off Time"),
			        IF (
			            SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Transportation Delay", 
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[Breakdown (Combined)]="Transportation Delay"),
			
			        IF (
			            SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Group Arbitrage", 
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[Breakdown (Combined)]="Group Arbitrage"),
			
			                IF (
			            SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "OOS-Demand planning", 
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[Breakdown (Combined)]="OOS-Demand planning"),
			
			                IF (
			            SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Transportation Delay", 
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[Breakdown (Combined)]="Transportation Delay"),
			
			                IF (
			            SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "allocation limit exceeded", 
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[Breakdown (Combined)]="allocation limit exceeded"),
			
			                IF (
			            SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Transportation Issue (Inbound)", 
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[Breakdown (Combined)]="Transportation Issue (Inbound)"),
			        
			            BLANK()  -- Optional: return BLANK() if none of the conditions are met
			        )
			    )
			)
			)))))
			```
