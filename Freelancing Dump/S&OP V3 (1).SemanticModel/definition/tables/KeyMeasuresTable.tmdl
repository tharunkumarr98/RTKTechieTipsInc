	measure Selection_SFA_Loss = ```
			
			
			var _perMarketresult = 
			
			var _reminder = divide(sum(SFA_Driver[Abs Delta on Order_CR]),sum(SFA_Driver[Order]))
			var _DriverPercent = [_Contrib_abs_delta]*_reminder
			
			RETURN _DriverPercent
			
			var _totalresult = 
			
			var _reminder = CALCULATE(divide(sum(SFA_Driver[Abs Delta on Order_CR]),sum(SFA_Driver[Order])), REMOVEFILTERS(Market))
			var _DriverPercent = CALCULATE([_Contrib_abs_delta]*_reminder,REMOVEFILTERS(Market))
			
			RETURN _DriverPercent
			
			RETURN if (SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)",_perMarketresult,_totalresult)
			
			
			
