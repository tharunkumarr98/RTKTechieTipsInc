			if ( SELECTEDVALUE('AccessValues#3'[Access]) = "July",CALCULATE(SUM('STD S&OP NY (2526)'[FY]),'STD S&OP NY (2526)'[Week]="28.2025",REMOVEFILTERS(Market)),
			if ( SELECTEDVALUE('AccessValues#3'[Access]) = "Budget",CALCULATE(SUM('STD BDGT'[FY]),REMOVEFILTERS(Market)),
			if ( SELECTEDVALUE('AccessValues#3'[Access]) = "LY",CALCULATE(SUM('STD S&OP LY (2425)'[FY]),REMOVEFILTERS(Market))
			))))
			
			
			
			RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)",_PerMarketResult, _TotalResult),VAR _PerMarketResult= 
			IF ( SELECTEDVALUE('AccessValues#3'[Access]) = "Jun",
			    CALCULATE(SUM('STT S&OP NY (2526)'[FY]), 'STT S&OP NY (2526)'[Week]="24.2025"),
			    IF ( SELECTEDVALUE('AccessValues#3'[Access]) = "July",
