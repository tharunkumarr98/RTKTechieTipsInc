	measure 'Act%Tgt temp' = ```
			
			
			VAR _ActPercentTgt = DIVIDE([Actuals], CALCULATE(SUM(Slide[LE])))
			VAR _Factor = CALCULATE(DIVIDE(max(ActBdgt[MTD - Actual])+max(ActBdgt[MTD BDGTmonth end]),0.3), REMOVEFILTERS(Market))// Set the factor to the max value of the secondary Y-axis
			VAR _ScaledValue = IF(ISBLANK(_ActPercentTgt), BLANK(), _ActPercentTgt * _Factor)
			RETURN 
			   _ScaledValue  // Scale the result back to a percentage (0 to 1)
			/*
			%Occupied temp = 
			Var __occupany = DIVIDE(
				SUM('Pallet_Capa'[Total Occupied (Act Pallets)]),
				SUM('Pallet_Capa'[Total Availble])
			)
			Var __Factor = CALCULATE( DIVIDE(MAX(Pallet_Capa[Max Capa])+MAX(Pallet_Capa[Contractual Capa]),2), REMOVEFILTERS(Mon_Sort_2))
			Var __Result = IF(ISBLANK(__occupany), BLANK(), __occupany * __Factor)
			RETURN __Result  
