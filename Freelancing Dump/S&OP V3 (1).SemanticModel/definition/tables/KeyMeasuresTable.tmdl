	measure 'STT 2425 SAF' =
			--STD
			SWITCH(
			    SELECTEDVALUE(Market[Market (Key)]),
			    "Saudi Arabia", CALCULATE(SUM('STT SAF'[Net Weight (QL)]), 'STT SAF'[G-Market (Ship-To)] = "Saudi Arabia"),
			    "Kuwait", CALCULATE(SUM('STT SAF'[Net Weight (QL)]), 'STT SAF'[G-Market (Ship-To)] = "Kuwait"),
			    "Dubai", CALCULATE(SUM('STT SAF'[Net Weight (QL)]), 'STT SAF'[G-Market (Ship-To)] = "Dubai"),
			    "Other Lower Gulf", CALCULATE(SUM('STT SAF'[Net Weight (QL)]), 'STT SAF'[G-Market (Ship-To)] IN { "Oman", "Bahrain", "Qatar", "Yemen", "Abu Dhabi" }),
			    "GAC (Gulf)", CALCULATE(SUM('STT SAF'[Net Weight (QL)]), REMOVEFILTERS(Market)),
			    BLANK()  // Default case if none of the conditions match
			)
		formatString: 0
		lineageTag: c0bfa0b4-5158-4de5-8b02-84b1043b1447

