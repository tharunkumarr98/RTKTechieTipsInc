	measure Selection_Misalignment_CY = ```
			
			
			IF (
			    SELECTEDVALUE(YrTable[Value]) = "2425",
			    IF (
			        SELECTEDVALUE(Month_Sort[Month]) <> "YTD" && SELECTEDVALUE(Month_Sort[Month]) <> "LY",
			        
			        IF (
			            SELECTEDVALUE(Month_Sort[Sort]) > 6, 
			            BLANK(),
			            VAR _perplantresult = 
			                1 - DIVIDE(SUM('Misalignment Report'[Abs (Free Diffr)]), SUM('Misalignment Report'[Free SAP qty]), 0)
			            RETURN _perplantresult
			        ),
			
			        // This is if YTD & LY
			        VAR _perplantresult = 
			            CALCULATE(
			                1 - DIVIDE(SUM('Misalignment Report'[Abs (Free Diffr)]), SUM('Misalignment Report'[Free SAP qty]), 0),
			                REMOVEFILTERS(Month_Sort)
			            )
			        RETURN _perplantresult
			    )
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 293a28f4-ca66-43ce-b64b-b0c4d5ec3b06

	measure MEP_Week_Contrib = ```
			
			
			var _PerMarketResult=
			
			VAR _CurrentDate = MAX('VL06O - DN'[Act. Gds Mvmnt Date])
			VAR _StartOfWeek = _CurrentDate - WEEKDAY(_CurrentDate, 2) + 1  -- Assuming the week starts on Monday
			
			VAR _DistinctCountDNsCurrentWeek = 
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        FILTER(
			            'VL06O - DN',
			            'VL06O - DN'[Act. Gds Mvmnt Date] >= _StartOfWeek &&
			            'VL06O - DN'[Act. Gds Mvmnt Date] < _StartOfWeek + 7
			        )
			    )
			
			VAR _TotalDistinctCountDNsMonth = 
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        FILTER(
			            'VL06O - DN',
			            MONTH('VL06O - DN'[Act. Gds Mvmnt Date]) = MONTH(_CurrentDate) &&
			            YEAR('VL06O - DN'[Act. Gds Mvmnt Date]) = YEAR(_CurrentDate)
			        )
			    )
			
			VAR _ContributionCurrentWeek = 
			    DIVIDE(
			        _DistinctCountDNsCurrentWeek,
			        _TotalDistinctCountDNsMonth,
			        0
			    )
			RETURN 
			    _ContributionCurrentWeek
			
			    ------------------------------------------------------below for gac
			
			    var _TotalResult=
			
			    VAR _CurrentDate = MAX('VL06O - DN'[Act. Gds Mvmnt Date])
			    VAR _StartOfWeek = _CurrentDate - WEEKDAY(_CurrentDate, 2) + 1  -- Assuming the week starts on Monday
			
			    VAR _DistinctCountDNsCurrentWeek = 
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        FILTER(
			            'VL06O - DN',
			            'VL06O - DN'[Act. Gds Mvmnt Date] >= _StartOfWeek &&
			            'VL06O - DN'[Act. Gds Mvmnt Date] < _StartOfWeek + 7
			        ), REMOVEFILTERS(Market)
			    )
			
			    VAR _TotalDistinctCountDNsMonth = 
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        FILTER(
			            'VL06O - DN',
			            MONTH('VL06O - DN'[Act. Gds Mvmnt Date]) = MONTH(_CurrentDate) &&
			            YEAR('VL06O - DN'[Act. Gds Mvmnt Date]) = YEAR(_CurrentDate)
			        ), REMOVEFILTERS(Market)
			    )
			
			VAR _ContributionCurrentWeek = 
			    DIVIDE(
			        _DistinctCountDNsCurrentWeek,
			        _TotalDistinctCountDNsMonth,
			        0
			    )
			RETURN 
			    _ContributionCurrentWeek
			
			
			RETURN if (SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)", _PerMarketResult, _TotalResult)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1764768c-eb56-40c1-8124-5e55d8c23303

