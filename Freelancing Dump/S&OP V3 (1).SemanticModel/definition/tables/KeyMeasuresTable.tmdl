	measure Selection_STD_CY_01 = ```
			
			--01
			
			If(SELECTEDVALUE(Month_Sort[Month])<> "YTD" && SELECTEDVALUE(Month_Sort[Month])<>"LY",
			
			if (SELECTEDVALUE('YrTable'[Value])="2425",
			
			Var _SelectedMarket = SELECTEDVALUE(Market[Market (Key)])
			Var _TotalResult =  
			
			Var Result=
			
			IF(SELECTEDVALUE(Month_Sort[Sort]) > 10,
			CALCULATE(     
			100 - IF (
			        SUM('SFA Folder'[01 Proj Abs]) >= SUM('SFA Folder'[STD Digitalization.Net Weight (QL)]),100,
			        SUM('SFA Folder'[01 Proj Abs]) / SUM('SFA Folder'[STD Digitalization.Net Weight (QL)]) * 100
			    ), REMOVEFILTERS(Market)),
			
			IF(SELECTEDVALUE(Month_Sort[Sort]) = 10,
			CALCULATE(     
			100 - IF (
			        SUM('SFA Folder'[2425 Abs 01]) >= SUM('SFA Folder'[2425 Order 01]),100,
			        SUM('SFA Folder'[2425 Abs 01]) / SUM('SFA Folder'[2425 Order 01]) * 100
			    ), REMOVEFILTERS(Market)), BLANK()))
			
			RETURN 
			        IF(Result = 0, BLANK(), Result)
			
			
			
			
			Var _PerMarketResult = 
			
			VAR CurrentSort = SELECTEDVALUE(Month_Sort[Sort])
			VAR Result = 
			    SWITCH(
			        TRUE(),
			        CurrentSort > 10,
			            CALCULATE(     
			                100 - IF (
			                    SUM('SFA Folder'[01 Proj Abs]) >= SUM('SFA Folder'[STD Digitalization.Net Weight (QL)]),
			                    100,
			                    DIVIDE(SUM('SFA Folder'[01 Proj Abs]), SUM('SFA Folder'[STD Digitalization.Net Weight (QL)]), 0) * 100
			                )
			            ),
			        CurrentSort = 10,
			            CALCULATE(     
			                100 - IF (
			                    SUM('SFA Folder'[2425 Abs 01]) >= SUM('SFA Folder'[2425 Order 01]),
			                    100,
			                    DIVIDE(SUM('SFA Folder'[2425 Abs 01]), SUM('SFA Folder'[2425 Order 01]), 0) * 100
			                )
			            ),
			        BLANK()  // Default case if no conditions are met
			    )
			RETURN 
			    IF(Result = 0, BLANK(), Result)
			
			
			
			RETURN IF(_SelectedMarket <> "GAC (GULF)",_PerMarketResult, _TotalResult),
			
			
			BLANK()))
			```
		lineageTag: 36f5b03e-1fda-4691-a907-f4e0a2fb8d5e

