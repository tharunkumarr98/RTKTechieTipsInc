	measure 'S&OP Values #One' = ```
			
			
			VAR _PerMarketResult= 
			if ( SELECTEDVALUE(AccessValues[Access]) = "YTD", CALCULATE(SUM('STD S&OP NY (2526)'[YTD])/1000), 
			if ( SELECTEDVALUE(AccessValues[Access]) = "FY Outlook", CALCULATE(SUM('STD S&OP NY (2526)'[FY])/1000), 
			BLANK()))
			
			VAR _TotalResult= 
			if ( SELECTEDVALUE(AccessValues[Access]) = "YTD",CALCULATE(SUM('STD S&OP NY (2526)'[YTD])/1000, REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE(AccessValues[Access]) = "FY Outlook", CALCULATE(SUM('STD S&OP NY (2526)'[FY])/1000, REMOVEFILTERS(Market)),
			BLANK()))
			
			RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", _PerMarketResult, _TotalResult)
			
			```
		formatString: 0
		lineageTag: 13833828-5313-412a-951b-e9f6eefa18ee

	measure 'S&OP Values #Two' = ```
			
			
			VAR _TotalResult= 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Jun",CALCULATE(SUM('STD S&OP LY (2425)'[06.2025]), REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Jul",CALCULATE(SUM('STD S&OP LY (2425)'[07.2025]), REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Aug",CALCULATE(SUM('STD S&OP LY (2425)'[08.2025]), REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S1",CALCULATE(SUM('STD S&OP LY (2425)'[09.2024])+SUM('STD S&OP LY (2425)'[10.2024])+SUM('STD S&OP LY (2425)'[11.2024])+SUM('STD S&OP LY (2425)'[12.2024]), REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S2",CALCULATE(SUM('STD S&OP LY (2425)'[01.2025])+SUM('STD S&OP LY (2425)'[02.2025])+SUM('STD S&OP LY (2425)'[03.2025])+SUM('STD S&OP LY (2425)'[04.2025]), REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S3",CALCULATE(SUM('STD S&OP LY (2425)'[05.2025])+SUM('STD S&OP LY (2425)'[06.2025])+SUM('STD S&OP LY (2425)'[07.2025])+SUM('STD S&OP LY (2425)'[08.2025]), REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "FY",CALCULATE(SUM('STD S&OP LY (2425)'[FY]), REMOVEFILTERS(Market)))))))))
			
			RETURN _TotalResult
			--(SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", BLANK(), _TotalResult)
			
