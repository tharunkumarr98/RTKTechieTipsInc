	measure Testtt = ```
			
			
			-- Summarize WeekClosingStock by country and communication reference
			VAR RelatedPCommRef = SUMMARIZE(WeekClosingStock, WeekClosingStock[Country | Comm Ref])
			
			    -- Get the selected week from the YearWeek table
				VAR __Selectedweek = SELECTEDVALUE(YearWeek[YearWeek])
				
			    -- Create a table of future weeks with cumulative demand and transit
			    VAR __tempTable = 
			    CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(
							VALUES(YearWeek[YearWeek]),
							YearWeek[YearWeek] > __Selectedweek -- Filter for weeks after the selected week
						),
			
						"CumilativeDemand", 	-- Add cumulative demand for each future week
			
			
			            VAR __Window = 
			            
			            CALCULATETABLE(WINDOW(
							0,
							ABS,
							0,
							REL,
							ALLSELECTED(YearWeek[YearWeek]),
							ORDERBY(
								YearWeek[YearWeek],
								ASC
							)
						))
			
			            -- Calculate cumulative demand
						VAR __CumilativeSTT = 
			            
			            CALCULATE([STT 2024], -- Calculate cumulative demand
			            __Window)
						RETURN
							__CumilativeSTT  -- Return cumulative demand
			
			           , "CumilativeTransit",        -- Add cumulative transit for each future week
			
			
			            VAR __Window = CALCULATETABLE(WINDOW(
							0,
							ABS,
							0,
							REL,
							ALLSELECTED(YearWeek[YearWeek]),
							ORDERBY(
								YearWeek[YearWeek],
								ASC
							)
						))
			            Var __CumilativeTransit = CALCULATE(
							[StockInTransit], -- Calculate cumulative transit
			                __Window
						)
						RETURN
							__CumilativeTransit  -- Return cumulative transit
			            
					, "DemandValue", [STT 2024]), 		-- Add demand value for each future week
			
					RelatedPCommRef, -- Include summarized country and reference info
					REMOVEFILTERS(YearWeek[YearWeek]) -- Remove filters on YearWeek
			
				)
			-------------------------------------------------------------------------------------
			-- Iteration1: -- Calculate total closing stock
				VAR __ClosingStock = SUM(WeekClosingStock[Closing Stock QL])
			
			
			-- Filter weeks where cumulative demand is less than or equal to stock (result: +ve subt)
				VAR __FilterFutureDemandLessThanClosingSotck = 
			    FILTER(
					__tempTable,
					[CumilativeDemand] <= __ClosingStock -- Demand fits within stock
				)
				
			    -- Filter weeks where cumulative demand exceeds stock (result: the -ve values)
			    VAR __FilterFutureDemandGreaterThanClosingSotck = 
			    FILTER(
					__tempTable,
					[CumilativeDemand] > __ClosingStock
				)   
			   
			   -- Find the earliest week when demand surpasses stock (result: the 1st wk where -ve appears)
			   Var __FilterFutureDemandGreaterThanClosingSotckWeek = MINX(__FilterFutureDemandGreaterThanClosingSotck, [YearWeek]) -- Earliest week demand exceeds stock
			
			--Iteration 2:-- Find maximum demand that fits within stock
			
			 
				VAR __MaxOfFilteredDataDemand = MAXX(
					__FilterFutureDemandLessThanClosingSotck,
					[CumilativeDemand]  -- Largest demand still within stock
				    ) 
			
			
			    -- Calculate remaining stock after fulfilling demand (this will give me the last +ve reminder after consuming the actual closing stock)
				VAR __RemainingStockInDemand = __ClosingStock - __MaxOfFilteredDataDemand -- Stock left after meeting demand
			
			-------------------------------------------------------------------------
			
			    -- max stock in transit = whenever the demand is grater than closing stock? 
			    Var __MaxStockInTransit = MAXX(__FilterFutureDemandGreaterThanClosingSotck, [CumilativeTransit])
			    -- Max transit in future weeks
			
			-- Calculate remaining stock outside demand (new) -- (this will give me the 1st -ve reminder after consuming the actual closing stock)
			VAR __RemainingStockOutDemand = CALCULATE((__RemainingStockInDemand - [STT 2024])*-1, YearWeek[YearWeek] = __FilterFutureDemandGreaterThanClosingSotckWeek )
			
			    -- Adjust future demand for weeks where demand exceeds stock (new) -- for the reminder in the beg
			    VAR __AdjustedFilterFutureDemandGreaterThanClosingSotck = SELECTCOLUMNS( ADDCOLUMNS( __FilterFutureDemandGreaterThanClosingSotck , "AdjustedDemand", ( [CumilativeDemand]  - __MaxOfFilteredDataDemand ) + __RemainingStockOutDemand ) , YearWeek[YearWeek], [CumilativeTransit],[AdjustedDemand],[DemandValue] )  -- Recalculate demand
			
			
			    -- Count weeks where adjusted demand is within transit capacity (less than or equal transit)>> Count the weeks of +ve value -- the value here is wrong
			    Var __NumberOfWeeks = COUNTROWS(FILTER( __AdjustedFilterFutureDemandGreaterThanClosingSotck, [AdjustedDemand] <= __MaxStockInTransit ) )  -- Number of weeks demand fits transit
			
			    -- Filter weeks where adjusted demand exceeds transit (this gives me -ve reminder list in transit itrations)
			    Var __FilterFutureDemandGreaterThanTransit = FILTER( __AdjustedFilterFutureDemandGreaterThanClosingSotck, [AdjustedDemand]  > __MaxStockInTransit ) -- Demand surpasses transit
			
			    -- Find the earliest week where demand exceeds transit --This is the wrong part
			    Var __MaxNexWeekCumilativeDemand = MINX(__FilterFutureDemandGreaterThanTransit, [YearWeek])-- -- Earliest week demand exceeds stock
			
			
				-- Find the demand value for the very next week --
			    VAR __VeryNextFutureDemand = SUMX(TOPN(1, __FilterFutureDemandGreaterThanTransit, [AdjustedDemand],ASC), [DemandValue] ) -- Demand in the next critical week
			    --CALCULATE([STT 2024], YearWeek[YearWeek] = __MaxNexWeekCumilativeDemand )
			
			    
			    -- Filter weeks where cumulative demand is less than or equal to transit stock
				VAR __FilterFutureDemandLessThanTransitSotck = 
			    FILTER( __AdjustedFilterFutureDemandGreaterThanClosingSotck, [AdjustedDemand] <= __MaxStockInTransit )
			    
			    VAR __MaxOfFilteredTransit = MAXX(
					__FilterFutureDemandLessThanTransitSotck,
					[AdjustedDemand]  -- Largest demand still within Transit stock
				    ) 
			
			    -- Calculate remaining stock in transit after meeting next week's demand
			    Var __RemainingStockinTransit = __MaxStockInTransit - __MaxOfFilteredTransit    -- Remaining transit stock
			
				-- Calculate how many weeks are needed to cover remaining demand
			    VAR __RemainingDemandWeeks = DIVIDE(
					__RemainingStockinTransit,
					__VeryNextFutureDemand
				)-- Demand per week
			
			    -- Sum total weeks needed, including partial week if any
				VAR Result = __NumberOfWeeks  + __RemainingDemandWeeks  -----------------------------
				
			    -- Return the result if stock is not blank
			    RETURN
				IF( NOT(ISBLANK(__ClosingStock))  ,  __NumberOfWeeks ) -- Output total weeks if stock exists
			
			```
		formatString: 0
		lineageTag: 6e0b9676-3bcc-4461-a3b0-a12abfd1919d

	measure 'Cumilative Sum Last' = ```
			
			--FutureWeeksStockDemand
			VAR RelatedPCommRef = SUMMARIZE(
					WeekClosingStock, WeekClosingStock[Country | Comm Ref])
			
				VAR __Selectedweek = SELECTEDVALUE(YearWeek[YearWeek])
				VAR __tempTable = CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(
							VALUES(YearWeek[YearWeek]),
							YearWeek[YearWeek] > __Selectedweek
						),
			
						"CumilativeDemand", 
			            VAR __Window = CALCULATETABLE(WINDOW(
							0,
							ABS,
							0,
							REL,
							ALLSELECTED(YearWeek[YearWeek]),
							ORDERBY(
								YearWeek[YearWeek],
								ASC
							)
						))
						VAR __CumilativeSTT = CALCULATE(
							[STT 2024],
							__Window
						)
						RETURN
							__CumilativeSTT  
			
			           , "CumilativeTransit", 
			            VAR __Window = CALCULATETABLE(WINDOW(
							0,
							ABS,
							0,
							REL,
							ALLSELECTED(YearWeek[YearWeek]),
							ORDERBY(
								YearWeek[YearWeek],
								ASC
							)
						))
			            Var __CumilativeTransit = CALCULATE(
							[StockInTransit],
			                __Window
						)
						RETURN
							__CumilativeTransit  
			            
					, "DemandValue", [STT 2024]),
					RelatedPCommRef,
					REMOVEFILTERS(YearWeek[YearWeek])
			
			
				)
			
			-- Iteration1 
				VAR __ClosingStock = SUM(WeekClosingStock[Closing Stock QL])
			    
				VAR __FilterFutureDemandLessThanClosingSotck = FILTER(
					__tempTable,
					[CumilativeDemand] <= __ClosingStock
				)
				VAR __FilterFutureDemandGreaterThanClosingSotck = FILTER(
					__tempTable,
					[CumilativeDemand] > __ClosingStock
				)   
			   
			   Var __FilterFutureDemandGreaterThanClosingSotckWeek = MINX(__FilterFutureDemandGreaterThanClosingSotck, [YearWeek])
			
			--Iteration 2
			 
				VAR __MaxOfFilteredDataDemand = MAXX(
					__FilterFutureDemandLessThanClosingSotck,
					[CumilativeDemand]
				    ) 
			
				VAR __RemainingStockInDemand = [Remaining Stock After Closing Stock]
			
			    Var __MaxStockInTransit = MAXX(__FilterFutureDemandGreaterThanClosingSotck, [CumilativeTransit])
			
			    VAR __AdjustedFilterFutureDemandGreaterThanClosingSotck = SELECTCOLUMNS( ADDCOLUMNS( __FilterFutureDemandGreaterThanClosingSotck , "AdjustedDemand", ( [CumilativeDemand]  - __MaxOfFilteredDataDemand ) + (-1 * __RemainingStockInDemand)   ) , YearWeek[YearWeek], [CumilativeTransit],[AdjustedDemand],[DemandValue] ) 
			
			    Var __FilterFutureDemandLessThanTransit = FILTER( __AdjustedFilterFutureDemandGreaterThanClosingSotck, [AdjustedDemand] <= __MaxStockInTransit )
			
			    Var __FilterFutureDemandGreaterThanTransit = FILTER( __AdjustedFilterFutureDemandGreaterThanClosingSotck, [AdjustedDemand] > __MaxStockInTransit )
			
			    Var __NumberOfWeeks = COUNTROWS(__FilterFutureDemandLessThanTransit ) 
			
			    Var __MaxNexWeekCumilativeDemand = MINX(__FilterFutureDemandGreaterThanTransit, [AdjustedDemand])
			
				VAR __VeryNextFutureDemand =SUMX(TOPN(1, __FilterFutureDemandGreaterThanTransit, [AdjustedDemand],ASC), [DemandValue] ) 
			
			    Var __RemainingStockinTransit = __MaxStockInTransit  -  MAXX(__FilterFutureDemandLessThanTransit, [AdjustedDemand])    
			
				VAR __RemainingDemandWeeks = DIVIDE(
					__RemainingStockinTransit,
					__VeryNextFutureDemand
				)
				VAR Result = __NumberOfWeeks  + __RemainingDemandWeeks + IF(__RemainingStockInDemand < 0,1,0) 
				RETURN
				IF( NOT(ISBLANK(__ClosingStock))  ,  Result )   
			
			
			```
		lineageTag: 802defd5-2b32-40d6-876b-b863a910c0d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cumilative Sum Actuals (old)' = ```
			
			--FutureWeeksStockDemand
			Var RelatedPCommRef = SUMMARIZE( WeekClosingStock, WeekClosingStock[Country | Comm Ref]) 
			Var __Selectedweek = SELECTEDVALUE(YearWeek[YearWeek])
			Var __tempTable = CALCULATETABLE( ADDCOLUMNS( FILTER( VALUES( FutureWeeksStockDemand[Year&Wk]), FutureWeeksStockDemand[Year&Wk] >= __Selectedweek ) , "tempCalc",
			Var __Window = CALCULATETABLE( WINDOW(0, ABS, 0, REL, ALLSELECTED(FutureWeeksStockDemand[Year&Wk]),ORDERBY(FutureWeeksStockDemand[Year&Wk],ASC)) )
			Var __Cumilative = CALCULATE( [STT 2024], __Window) 
			RETURN __Cumilative,  "DemandValue", [STT 2024]
			),RelatedPCommRef, REMOVEFILTERS(YearWeek[YearWeek]))  
			Var __ClosingStock = SUM(WeekClosingStock[Closing Stock QL]) 
			Var __FilterFutureDemandLessThanClosingSotck = FILTER( __tempTable, [tempCalc] <= __ClosingStock )
			Var __FilterFutureDemandGreaterThanClosingSotck = FILTER( __tempTable, [tempCalc] > __ClosingStock )
			Var __NumberOfWeeks = COUNTROWS( __FilterFutureDemandLessThanClosingSotck ) 
			Var __MaxOfFilteredData = MAXX(__FilterFutureDemandLessThanClosingSotck, [tempCalc]) 
			Var __RemainingStock = __ClosingStock - __MaxOfFilteredData 
			Var __VeryNextFutureDemand = SUMX(TOPN(1, __FilterFutureDemandGreaterThanClosingSotck, [tempCalc],ASC), [DemandValue] ) 
			Var __RemainingDemandWeeks = DIVIDE(__RemainingStock,__VeryNextFutureDemand)
			Var Result = __NumberOfWeeks + __RemainingDemandWeeks
			RETURN IF(ISBLANK(__ClosingStock), BLANK(), Result ) 
			
			```
		lineageTag: 82b30f75-33e6-4ac7-a21c-f2c570dfee24

