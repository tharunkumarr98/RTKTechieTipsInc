		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OTIF_Waterfall_Reason = ```
			
			
			if (SELECTEDVALUE(OTIF_Parameter[OTIF_Parameter Order])=0,
			    
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Reason]) = "Total",
			
			        IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", DIVIDE(sum(OTIF[ORDERQTY (TU)]),sum(OTIF[ORDERQTY (TU)]))*100,CALCULATE(DIVIDE(sum(OTIF[ORDERQTY (TU)]),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), CALCULATE([OTIF_Total_Bucket], REMOVEFILTERS(OTIF[Breakdown (Combined)]))),
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Reason]) = "Not Delivered", 
			
			        IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-On-Time vs CDD]="Not Delivered"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-On-Time vs CDD]="Not Delivered"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-On-Time vs CDD] = "Not Delivered")),
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Reason]) = "Delivered Not On Time",
			        IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-On-Time vs CDD]="Delivered Not On Time"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-On-Time vs CDD]="Delivered Not On Time"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))),CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-On-Time vs CDD] = "Delivered Not On Time"))))),
			
			        -------------------------------------------------------------------
			        
			    IF (SELECTEDVALUE(OTIF_Parameter[OTIF_Parameter Order]) = 1,
			    
			    IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Total", IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%", IF ( SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)])), SUM(OTIF[ORDERQTY (TU)])) * 100, CALCULATE(DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)])),SUM(OTIF[ORDERQTY (TU)])) * 100, REMOVEFILTERS(Market))),CALCULATE([OTIF_Total_Bucket], REMOVEFILTERS(OTIF[Breakdown (Combined)]))),
			
			        VAR Top_1_Reason = [OTIF_Top_1_Reason]
			        VAR Top_2_Reason = [OTIF_Top_2_Reason]
			        VAR Top_3_Reason = [OTIF_Top_3_Reason]
			        VAR Top_4_Reason = [OTIF_Top_4_Reason]
			        VAR Top_5_Reason = [OTIF_Top_5_Reason]
			        VAR Top_6_Reason = [OTIF_Top_6_Reason]
			        
			        RETURN IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = Top_1_Reason, IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%", 
			        --ORDERQTY (TU) --Gap Qty TU
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_1_Reason,OTIF[D-On-Time vs CDD] <>"On Time",OTIF[Yr]="2425"),CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425")) * 100,
			        --this is for gac
			        -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_1_Reason,OTIF[D-On-Time vs CDD] <>"On Time", REMOVEFILTERS(Market),OTIF[Yr]="2425"), CALCULATE(SUM(OTIF[ORDERQTY (TU)]), REMOVEFILTERS(Market),OTIF[Yr]="2425"))*100),
			        --this is for other types of calculations
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty], OTIF[Breakdown (Combined)] = Top_1_Reason,OTIF[D-On-Time vs CDD] <>"On Time")), 
			        -------Other
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Other", IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%",
			        
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)",-1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[D-On-Time vs CDD] <> "On Time", NOT(OTIF[Breakdown (Combined)] IN {Top_6_Reason,Top_5_Reason,Top_4_Reason,Top_3_Reason,Top_2_Reason,Top_1_Reason})),SUM(OTIF[ORDERQTY (TU)])) * 100, CALCULATE(-1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[D-On-Time vs CDD] <> "On Time", NOT (OTIF[Breakdown (Combined)] IN {Top_6_Reason,Top_5_Reason,Top_4_Reason,Top_3_Reason,Top_2_Reason,Top_1_Reason})),SUM(OTIF[ORDERQTY (TU)])) * 100,REMOVEFILTERS(Market))),
			        
			        CALCULATE(-1 * [OTIF_Total_Bucket],OTIF[D-On-Time vs CDD] <> "On Time",NOT (OTIF[Breakdown (Combined)] IN {Top_6_Reason,Top_5_Reason,Top_4_Reason,Top_3_Reason,Top_2_Reason,Top_1_Reason}))),
			        ------other ends
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = Top_2_Reason, IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%", 
			        
			        --ORDERQTY (TU) --Gap Qty TU
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_2_Reason,OTIF[D-On-Time vs CDD] <>"On Time",OTIF[Yr]="2425"),CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425")) * 100,
			        --this is for gac
			        -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_2_Reason,OTIF[D-On-Time vs CDD] <>"On Time", REMOVEFILTERS(Market),OTIF[Yr]="2425"), CALCULATE(SUM(OTIF[ORDERQTY (TU)]), REMOVEFILTERS(Market),OTIF[Yr]="2425"))*100),
			        --this is for other types of calculations
			        
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty], OTIF[Breakdown (Combined)] = Top_2_Reason,OTIF[D-On-Time vs CDD] <>"On Time")),
			
			        
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = Top_3_Reason, IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%", 
			        
			        --ORDERQTY (TU) --Gap Qty TU
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_3_Reason,OTIF[D-On-Time vs CDD] <>"On Time",OTIF[Yr]="2425"),CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425")) * 100,
			        --this is for gac
			        -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_3_Reason,OTIF[D-On-Time vs CDD] <>"On Time", REMOVEFILTERS(Market),OTIF[Yr]="2425"), CALCULATE(SUM(OTIF[ORDERQTY (TU)]), REMOVEFILTERS(Market),OTIF[Yr]="2425"))*100),
			        --this is for other types of calculations
			                
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty], OTIF[Breakdown (Combined)] = Top_3_Reason,OTIF[D-On-Time vs CDD] <>"On Time")),
			                    
			        
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = Top_4_Reason, IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%", 
			                
			        --ORDERQTY (TU) --Gap Qty TU
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_4_Reason,OTIF[D-On-Time vs CDD] <>"On Time",OTIF[Yr]="2425"),CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425")) * 100,
			        --this is for gac
			        -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_4_Reason,OTIF[D-On-Time vs CDD] <>"On Time", REMOVEFILTERS(Market),OTIF[Yr]="2425"), CALCULATE(SUM(OTIF[ORDERQTY (TU)]), REMOVEFILTERS(Market),OTIF[Yr]="2425"))*100),
			        --this is for other types of calculations
			                
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty], OTIF[Breakdown (Combined)] = Top_4_Reason,OTIF[D-On-Time vs CDD] <>"On Time")),
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = Top_5_Reason, IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%", 
			                
			        --ORDERQTY (TU) --Gap Qty TU
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_5_Reason,OTIF[D-On-Time vs CDD] <>"On Time",OTIF[Yr]="2425"),CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425")) * 100,
			        --this is for gac
			        -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_5_Reason,OTIF[D-On-Time vs CDD] <>"On Time", REMOVEFILTERS(Market),OTIF[Yr]="2425"), CALCULATE(SUM(OTIF[ORDERQTY (TU)]), REMOVEFILTERS(Market),OTIF[Yr]="2425"))*100),
			        --this is for other types of calculations
			                
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty], OTIF[Breakdown (Combined)] = Top_5_Reason,OTIF[D-On-Time vs CDD] <>"On Time")),
			
			                
			                
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = Top_6_Reason, IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%", 
			                
			        --ORDERQTY (TU) --Gap Qty TU
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_6_Reason,OTIF[D-On-Time vs CDD] <>"On Time",OTIF[Yr]="2425"),CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425")) * 100,
			        --this is for gac
			        -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (Combined)] = Top_6_Reason,OTIF[D-On-Time vs CDD] <>"On Time", REMOVEFILTERS(Market),OTIF[Yr]="2425"), CALCULATE(SUM(OTIF[ORDERQTY (TU)]), REMOVEFILTERS(Market),OTIF[Yr]="2425"))*100),
			        --this is for other types of calculations
			                
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty], OTIF[Breakdown (Combined)] = Top_6_Reason,OTIF[D-On-Time vs CDD] <>"On Time")))))))))),
			        
			        ---------------------------------------------------------------------------------------------------------
			        if (SELECTEDVALUE(OTIF_Parameter[OTIF_Parameter Order])=2,
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Total", 
			
			         if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)",  DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)])),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE( DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)])),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE([OTIF_Total_Bucket],REMOVEFILTERS(OTIF[D-RC Cluster]))),
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Supply Chain",
			
			        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Supply Chain"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Supply Chain"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			        
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-RC Cluster]="Supply Chain")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Commercial", --Commercial
			
			
			        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Commercial"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Commercial"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			                
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-RC Cluster]="Commercial")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "IT", 
			
			        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="IT"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="IT"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-RC Cluster]="IT")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Forecast", 
			
			        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Forecast"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Forecast"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-RC Cluster]="Forecast")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Industrial", 
			
			                if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Industrial"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Industrial"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-RC Cluster]="Industrial")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Not Assigned", --HERE IS LIKE OTHERS
			
			                if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Not Assigned",OTIF[D-On-Time vs CDD] <> "On Time"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Not Assigned",OTIF[D-On-Time vs CDD] <> "On Time"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-RC Cluster]="Not Assigned",OTIF[D-On-Time vs CDD] <> "On Time")),
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Contingency", 
			
			                if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Contingency"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Contingency"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			        
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-RC Cluster]="Contingency")),
			
			        
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Project Delay", 
			
			                        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Project Delay"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Project Delay"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF_Qty],OTIF[D-RC Cluster]="Project Delay")
			        
			        )))))))))))))--))
