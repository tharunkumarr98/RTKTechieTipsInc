	measure Selection_Cvg_WA_CY_Graph = ```
			
			
			IF(SELECTEDVALUE(YrTable[Value])="2425",
			
			 -- for ytd & ly
			if (SELECTEDVALUE(Month_Sort[Month])<>"YTD" && SELECTEDVALUE(Month_Sort[Month])<>"LY",  -- for ytd cards
			
			    if(NOT ISBLANK( SELECTEDVALUE(Conc_Table[Desc (Key)])) || NOT ISBLANK(SELECTEDVALUE('Brand_Table'[Brand (Key)])),
			
			            IF (NOT ISBLANK( SELECTEDVALUE(Conc_Table[Desc (Key)])), -- once it's sku line
			            CALCULATE(
			            DIVIDE(
			            SUMX('SKU_Level_Cvg', 'SKU_Level_Cvg'[Closing Stock QL] * 'SKU_Level_Cvg'[Stock Coverage WK]),
			            SUM('SKU_Level_Cvg'[Closing Stock QL])
			            ), SKU_Level_Cvg[Yr]="2425"),
			
			                IF (NOT ISBLANK( SELECTEDVALUE('Brand_Table'[Brand (Key)])), --|| ISINSCOPE('Brand_Table_Cvg'[Short Name])) -- once it's brand line
			                CALCULATE(
			                DIVIDE(
			                SUMX(Brand_Level_Cvg, Brand_Level_Cvg[cvg w+1] * Brand_Level_Cvg[cvg]),
			                SUM(Brand_Level_Cvg[cvg w+1])), Brand_Level_Cvg[Yr]="2425"))),
			
			
			            --this is for grand total line
