			        --this is for other types of calculations
			        CALCULATE(-1 * [Selected_Measure_OTIF], OTIF[Breakdown (combined)] = Top_1_Reason,OTIF[D-On-Time vs CDD] <>"On Time")), 
			        -------Other
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Detailed Reason]) = "Other", IF (SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]) = "Contrib%",
			        
