	measure Selection_SA_CY_Group = ```
			
			
			If(SELECTEDVALUE('YrTable'[Value]) = "2425",
			    
			    IF (SELECTEDVALUE(Month_Sort[Month]) <> "YTD" && SELECTEDVALUE(Month_Sort[Month]) <> "LY",
			        
			        VAR _PerMarketResult = --below sfa formula
			        
			        VAR RESULT = 
			        CALCULATE(     100 -IF (
			                (SUM('Shipment Acc'[Proposed])-SUM('Shipment Acc'[Deployed])) >= SUM('Shipment Acc'[Proposed]),100,
			         (ABS(SUM('Shipment Acc'[Proposed])-SUM('Shipment Acc'[Deployed]))) / SUM('Shipment Acc'[Proposed]))* 100
			        )
			        RETURN
			        IF(Result = 0, BLANK(), Result)
			
			        VAR _TotalResult = 
			        VAR RESULT = 
			
			        CALCULATE(     100 -IF (
			                (SUM('Shipment Acc'[Proposed])-SUM('Shipment Acc'[Deployed])) >= SUM('Shipment Acc'[Proposed]),100,
			         (ABS(SUM('Shipment Acc'[Proposed])-SUM('Shipment Acc'[Deployed]))) / SUM('Shipment Acc'[Proposed]))* 100,REMOVEFILTERS(Market)
			        )
			
			        RETURN
