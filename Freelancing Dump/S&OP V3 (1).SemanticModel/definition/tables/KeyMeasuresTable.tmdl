	measure 'STT 2024' = ```
			
			VAR _PerMarketResult = SUM(FutureWeeksStockDemand[STT - FY Act+For 2024])
			VAR _JVResult = CALCULATE(
			    SUM(FutureWeeksStockDemand[STT - FY Act+For 2024]),
			    REMOVEFILTERS(Market)
			)
			RETURN
			IF(
			    SELECTEDVALUE(Market[Market (Key)]) <> "Direct Market",
			    _PerMarketResult,
			    _JVResult
			)
			
			```
		formatString: #,0.0
