			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Oct",CALCULATE(SUM('STD BDGT'[Sum of VOL OCT])/1000),
			
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Nov",CALCULATE(SUM('STD BDGT'[Sum of VOL NOV])/1000), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Dec",CALCULATE(SUM('STD BDGT'[Sum of VOL DEC])/1000), 
			
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S1",CALCULATE((SUM('STD BDGT'[Sum of VOL SEP])+SUM('STD BDGT'[Sum of VOL OCT])+SUM('STD BDGT'[Sum of VOL NOV])+SUM('STD BDGT'[Sum of VOL DEC]))/1000), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S2",CALCULATE((SUM('STD BDGT'[Sum of VOL JAN])+SUM('STD BDGT'[Sum of VOL FEB])+SUM('STD BDGT'[Sum of VOL MAR])+SUM('STD BDGT'[Sum of VOL APR]))/1000), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S3",CALCULATE((SUM('STD BDGT'[Sum of VOL MAY])+SUM('STD BDGT'[Sum of VOL JUN])+SUM('STD BDGT'[Sum of VOL JUL])+SUM('STD BDGT'[Sum of VOL AUG]))/1000), 
			
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "FY",CALCULATE(SUM('STD BDGT'[FY])/1000)))))))))
			
			VAR _TotalResult= 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Sep",CALCULATE(SUM('STD BDGT'[Sum of VOL SEP])/1000, REMOVEFILTERS(Market)),
			
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Oct",CALCULATE(SUM('STD BDGT'[Sum of VOL OCT])/1000, REMOVEFILTERS(Market)),
			
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Nov",CALCULATE(SUM('STD BDGT'[Sum of VOL NOV])/1000, REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "Dec",CALCULATE(SUM('STD BDGT'[Sum of VOL DEC])/1000, REMOVEFILTERS(Market)), 
			
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S1",CALCULATE((SUM('STD BDGT'[Sum of VOL SEP])+SUM('STD BDGT'[Sum of VOL OCT])+SUM('STD BDGT'[Sum of VOL NOV])+SUM('STD BDGT'[Sum of VOL DEC]))/1000, REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S2",CALCULATE((SUM('STD BDGT'[Sum of VOL JAN])+SUM('STD BDGT'[Sum of VOL FEB])+SUM('STD BDGT'[Sum of VOL MAR])+SUM('STD BDGT'[Sum of VOL APR]))/1000, REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "S3",CALCULATE((SUM('STD BDGT'[Sum of VOL MAY])+SUM('STD BDGT'[Sum of VOL JUN])+SUM('STD BDGT'[Sum of VOL JUL])+SUM('STD BDGT'[Sum of VOL AUG]))/1000, REMOVEFILTERS(Market)), 
			
			if ( SELECTEDVALUE('AccessValues#2'[Access]) = "FY",CALCULATE(SUM('STD BDGT'[FY])/1000, REMOVEFILTERS(Market))))))))))
			
			
