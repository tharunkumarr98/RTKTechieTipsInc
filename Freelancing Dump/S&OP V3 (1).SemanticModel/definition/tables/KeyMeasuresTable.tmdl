			         (ABS(SUM('Shipment Acc'[Proposed])-SUM('Shipment Acc'[Deployed]))) / SUM('Shipment Acc'[Proposed]))* 100,REMOVEFILTERS(Market), REMOVEFILTERS(Month_Sort)
			        )
			
