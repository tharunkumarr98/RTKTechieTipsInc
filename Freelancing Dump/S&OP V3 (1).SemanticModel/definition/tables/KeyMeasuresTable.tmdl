	measure Selected_Qtls = ```
			
			
			VAR _PerMarketResult = 
			if (SELECTEDVALUE(YrTable[Value])="2324", sum('vl06o - container' [2324 Qtls]),
			if (SELECTEDVALUE(YrTable[Value])="2425",sum('vl06o - container' [2425 Qtls]), BLANK()))
			
			
			VAR _TotalResult = 
			
			if (SELECTEDVALUE(YrTable[Value])="2324", CALCULATE(sum('vl06o - container' [2324 Qtls]), REMOVEFILTERS(Market)),
			if (SELECTEDVALUE(YrTable[Value])="2425",CALCULATE(sum('vl06o - container' [2425 Qtls]), REMOVEFILTERS(Market))))
			
			RETURN if(SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)",_PerMarketResult,_TotalResult)
			```
