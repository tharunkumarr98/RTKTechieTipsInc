	measure Selected_Measure_OTIF_TT = ```
			
			
			IF (SELECTEDVALUE(YrTable[Value])="2324",
			var _PerMarketResult = 
			SWITCH(
			    SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]),
			    "Gap_QL", SUM(OTIF_TT[2324 GAP Qtls]),
			    "Gap_Euro", SUM(OTIF_TT[2324 GAP Val]),
			    "Contrib%", [Contrb_OTIF_TT],
			    "Gap_TUs", CALCULATE(SUM(OTIF_TT[Gap Qty TU]),OTIF_TT[Yr]="2324"),
			  [Contrb_OTIF_TT])  -- default to ValueMeasure if no selection is made)
			
			var _TotalResult = 
			CALCULATE(
			SWITCH(
			    SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]),
			    "Gap_QL", SUM(OTIF_TT[2324 GAP Qtls]),
			    "Gap_Euro", SUM(OTIF_TT[2324 GAP Val]),
			    "Contrib%", [Contrb_OTIF_TT],
			    "Gap_TUs", CALCULATE(SUM(OTIF_TT[Gap Qty TU]),OTIF_TT[Yr]="2324"),
			  [Contrb_OTIF_TT])  -- default to ValueMeasure if no selection is made)
			)
			
			Return if (SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)", _PerMarketResult, _TotalResult),
			
			-------------------------------------- remaining years
			IF (SELECTEDVALUE(YrTable[Value])="2425",
			var _PerMarketResult = 
			SWITCH(
			    SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]),
			    "Gap_QL", SUM(OTIF_TT[2425 GAP Qtls]),
			    "Gap_Euro", SUM(OTIF_TT[2425 GAP Val]),
			    "Contrib%", [Contrb_OTIF_TT],
			    "Gap_TUs", CALCULATE(SUM(OTIF_TT[Gap Qty TU]),OTIF_TT[Yr]="2425"),
