	measure Contrb_Ref = ```
			
			
			if(SELECTEDVALUE(YrTable[Value])="2425",
			VAR TotalValue = CALCULATE(DISTINCTCOUNT('Returns and Refusals'[D-# Sales Doc.]),'Returns and Refusals'[Yr]="2425")
			VAR TotalValueAllSelected = 
			    CALCULATE(
			        DISTINCTCOUNT('Returns and Refusals'[D-# Sales Doc.]),'Returns and Refusals'[Yr]="2425",
			        ALLSELECTED()
			    )
			RETURN 
			DIVIDE(
			    TotalValue, 
			    TotalValueAllSelected, 
			    0
			) * 100 --,
			/*
			if(SELECTEDVALUE(YrTable[Value])="2223",
			VAR TotalValue = DISTINCTCOUNT(Reversals[2223 Bill Docs])
			VAR TotalValueAllSelected = 
			    CALCULATE(
			        DISTINCTCOUNT(Reversals[2223 Bill Docs]),
			        ALLSELECTED()
			    )
			RETURN 
			DIVIDE(
			    TotalValue, 
			    TotalValueAllSelected, 
			    0
			) * 100
			*/
			)--))
			```
