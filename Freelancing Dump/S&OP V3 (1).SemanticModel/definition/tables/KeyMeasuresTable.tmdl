	measure 'STD Full Year' = ```
			
			VAR SelectedMarket = SELECTEDVALUE(Market[Market (Key)], "GAC (Gulf)") // Default to "GAC (Gulf)" if nothing is selected
			VAR IsAllSelected = ISFILTERED(Market[Market (Key)]) = FALSE // Check if "All" is selected
			RETURN
			SWITCH(
			    TRUE(),
			    IsAllSelected, // If "All" is selected
			        CALCULATE(SUM('STD (FY,LY)'[Net Weight (QL)]), REMOVEFILTERS(Market), 'STD (FY,LY)'[Yr] <> "2324"),
			    SelectedMarket = "Saudi Arabia", 
			        CALCULATE(SUM('STD (FY,LY)'[Net Weight (QL)]), 'STD (FY,LY)'[G-Market (Ship-To)] = "Saudi Arabia", 'STD (FY,LY)'[Yr] <> "2324", ALL('STD (FY,LY)'[S&OP Date])),
			    SelectedMarket = "Kuwait", 
			        CALCULATE(SUM('STD (FY,LY)'[Net Weight (QL)]), 'STD (FY,LY)'[G-Market (Ship-To)] = "Kuwait", 'STD (FY,LY)'[Yr] <> "2324", ALL('STD (FY,LY)'[S&OP Date])),
			    SelectedMarket = "Dubai", 
			        CALCULATE(SUM('STD (FY,LY)'[Net Weight (QL)]), 'STD (FY,LY)'[G-Market (Ship-To)] = "Dubai", 'STD (FY,LY)'[Yr] <> "2324", ALL('STD (FY,LY)'[S&OP Date])),
			    SelectedMarket = "Other Lower Gulf", 
			        CALCULATE(SUM('STD (FY,LY)'[Net Weight (QL)]), 'STD (FY,LY)'[G-Market (Ship-To)] IN { "Oman", "Bahrain", "Qatar", "Yemen", "Abu Dhabi" }, 'STD (FY,LY)'[Yr] <> "2324", ALL('STD (FY,LY)'[S&OP Date])),
			    SelectedMarket = "GAC (Gulf)", 
			        CALCULATE(SUM('STD (FY,LY)'[Net Weight (QL)]), REMOVEFILTERS(Market), 'STD (FY,LY)'[Yr] <> "2324")
			)
			
			```
		lineageTag: dc015f62-89cc-47c0-b6a6-2e86bc5c8e10

