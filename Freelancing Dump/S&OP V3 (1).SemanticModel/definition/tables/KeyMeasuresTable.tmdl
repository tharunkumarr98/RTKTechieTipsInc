	measure 'STT Full Year' = ```
			
			VAR SelectedMarket = SELECTEDVALUE(Market[Market (Key)], "GAC (Gulf)") // Default to "GAC (Gulf)" if nothing is selected
			VAR IsAllSelected = NOT(ISFILTERED(Market[Market (Key)])) // Check if "All" is selected
			RETURN
			SWITCH(
			    TRUE(),
			    IsAllSelected, 
			        CALCULATE(SUM('STD (FY,LY)'[Net Weight (QL)]), REMOVEFILTERS(Market)),
			    SelectedMarket = "Saudi Arabia", 
			        CALCULATE(SUM('STT (FY, LY)'[Net Weight (QL)]), 'STT (FY, LY)'[G-Market (Ship-To)] = "Saudi Arabia", ALL('STT (FY, LY)'[T-Fiscal Year - Copy])),
			    SelectedMarket = "Kuwait", 
