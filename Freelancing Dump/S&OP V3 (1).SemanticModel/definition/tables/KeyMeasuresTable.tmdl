	measure Timepassed = ```
			
			VAR _StartOfMonth = DATE(YEAR(TODAY()), MONTH(TODAY())-1, 1) // if you want Subtract 1 to count days up to yesterday PUT IT AFTER TODAY()-2 HERE
			VAR _EndOfMonth = EOMONTH(_StartOfMonth, 0)
			VAR TotalDaysInMonth = DAY(_EndOfMonth)
			VAR DaysPassed = DAY(TODAY())+16  // if you want Subtract 1 to count days up to yesterday PUT IT AFTER TODAY()-2 HERE
			RETURN
			IF(
			    TotalDaysInMonth > 0,
			    DIVIDE(DaysPassed, TotalDaysInMonth, 0),
			    0
			)
			
			```
