			         (ABS(SUM('Shipment Acc'[Proposed])-SUM('Shipment Acc'[Deployed]))) / SUM('Shipment Acc'[Proposed]))* 100, REMOVEFILTERS(Month_Sort)
			        )
			
			        VAR _TotalResult = 
			        
