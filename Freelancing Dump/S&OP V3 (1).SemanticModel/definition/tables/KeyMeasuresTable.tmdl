	measure Act_Indust_G_Out_Graph_kpi = ```
			
			VAR SelectedMarket = SELECTEDVALUE('market'[market (key)])
			VAR SelectedTimeFrame = SELECTEDVALUE('Slicer Table_Cvg'[Value])
			VAR LastAvailableDate = MAX('VL06O - Container'[Goods Issue Date])  
			
			RETURN
			    SWITCH(
			        TRUE(),
			        SelectedMarket = "GAC (Gulf)" && ISFILTERED('market'[market (key)]),
			            DIVIDE(
			                SUM('VL06O - Container'[Act_Indust_Gate_Out_Weighted]),
			                SUM('VL06O - Container'[QL]),
			                0
			            ),
			        SelectedTimeFrame = "MTD",
			            DIVIDE(
			                CALCULATE(
			                    SUM('VL06O - Container'[Act_Indust_Gate_Out_Weighted]),
			                    DATESINPERIOD('VL06O - Container'[Goods Issue Date], LastAvailableDate, -2, MONTH)
			                ),
			                CALCULATE(
			                    SUM('VL06O - Container'[QL]),
			                    DATESINPERIOD('VL06O - Container'[Goods Issue Date] ,LastAvailableDate, -2, MONTH)
			                ),
			                0
			            ),
			        SelectedTimeFrame = "YTD",
			            DIVIDE(
			                CALCULATE(
			                    SUM('VL06O - Container'[Act_Indust_Gate_Out_Weighted]),
			                    FILTER(
			                        'VL06O - Container',
			                        'VL06O - Container'[Goods Issue Date] >= DATE(2023, 9, 1) && 'VL06O - Container'[Goods Issue Date] <= LastAvailableDate
			                    )
			                ),
			                CALCULATE(
			                    SUM('VL06O - Container'[QL]),
			                    FILTER(
			                        'VL06O - Container',
			                        'VL06O - Container'[Goods Issue Date] >= DATE(2023, 9, 1) && 'VL06O - Container'[Goods Issue Date] <= LastAvailableDate
			                    )
			                ),
			                0
			            ),
			        // Default case (if none of the above conditions are met)
			        DIVIDE(
			            SUM('VL06O - Container'[Act_Indust_Gate_Out_Weighted]),
			            SUM('VL06O - Container'[QL]),
			            0
			        )
			    )
			
			```
		lineageTag: aa9985c4-385f-4d10-a9e4-dc62069213da

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Vol_Tgt = ```
			if(SELECTEDVALUE('Slicer Table_Main'[Value])="MTD", 
			CALCULATE(
