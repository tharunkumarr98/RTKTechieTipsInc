	measure Selection_Numb_CY = ```
			
			
			Var _permarketresult = 
			IF(
			    SELECTEDVALUE(YrTable[Value]) = "2425",
			    IF(
			        SELECTEDVALUE(Radio_Button_Option[Radio_Button_Option]) = "Number of Docs",
			        DIVIDE(
			            CALCULATE(
			                DISTINCTCOUNT('VL06O - DN'[Delivery]),
			                'VL06O - DN'[Yr] = "2425"
			            ),
			            CALCULATE(
			                DISTINCTCOUNT('VL06O - DN'[Delivery]),
			                ALLSELECTED('VL06O - DN'), 'VL06O - DN'[Yr] = "2425"
			            )
			        ), --this is if qtls
			                DIVIDE(
			            CALCULATE(
			                sum('VL06O - DN'[Net weight (KG)])/100,
			                'VL06O - DN'[Yr] = "2425"
			            ),
			            CALCULATE(
			                SUM('VL06O - DN'[Net weight (KG)])/100,
			                ALLSELECTED('VL06O - DN'), 'VL06O - DN'[Yr] = "2425"
			            )
			        )
			    ), BLANK()
			)
			
			var _totalresult = 
			
			 
			IF(
			    SELECTEDVALUE(YrTable[Value]) = "2425",
			
			    CALCULATE(
			    IF(
			        SELECTEDVALUE(Radio_Button_Option[Radio_Button_Option]) = "Number of Docs",
			        DIVIDE(
			            CALCULATE(
			                DISTINCTCOUNT('VL06O - DN'[Delivery]),
			                'VL06O - DN'[Yr] = "2425"
			            ),
			            CALCULATE(
			                DISTINCTCOUNT('VL06O - DN'[Delivery]),
			                ALLSELECTED('VL06O - DN'), 'VL06O - DN'[Yr] = "2425"
			            )
			        ), --this is if qtls
			                DIVIDE(
			            CALCULATE(
			                sum('VL06O - DN'[Net weight (KG)])/100,
			                'VL06O - DN'[Yr] = "2425"
			            ),
			            CALCULATE(
			                SUM('VL06O - DN'[Net weight (KG)])/100,
			                ALLSELECTED('VL06O - DN'), 'VL06O - DN'[Yr] = "2425"
			            )
			        )
			    ), REMOVEFILTERS(Market)), BLANK()
			)
			
			RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", _permarketresult,_totalresult)
			
			
