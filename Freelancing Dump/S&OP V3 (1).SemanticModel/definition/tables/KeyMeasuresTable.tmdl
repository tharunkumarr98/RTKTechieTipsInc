			            IF ( SELECTEDVALUE('AccessValues#3'[Access]) = "LY",
			                CALCULATE(SUM('STT S&OP LY (2425)'[FY]))
			            )
			        )
			    )
			)
			
			VAR _TotalResult= 
			IF ( SELECTEDVALUE('AccessValues#3'[Access]) = "Jun",
			    CALCULATE(SUM('STT S&OP NY (2526)'[FY]), 'STT S&OP NY (2526)'[Week]="24.2025", REMOVEFILTERS(Market)),
			    IF ( SELECTEDVALUE('AccessValues#3'[Access]) = "July",
			        CALCULATE(SUM('STT S&OP NY (2526)'[FY]), 'STT S&OP NY (2526)'[Week]="28.2025", REMOVEFILTERS(Market)),
			        IF ( SELECTEDVALUE('AccessValues#3'[Access]) = "Budget",
			            CALCULATE(SUM('STT BDGT'[FY]), REMOVEFILTERS(Market)),
			            IF ( SELECTEDVALUE('AccessValues#3'[Access]) = "LY",
			                CALCULATE(SUM('STT S&OP LY (2425)'[FY]), REMOVEFILTERS(Market))
			            )
			        )
			    )
			)
			
			RETURN IF(SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", _PerMarketResult, _TotalResult)
			
			)
