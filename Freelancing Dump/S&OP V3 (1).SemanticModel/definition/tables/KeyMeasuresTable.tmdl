	measure Selected_Measure_OTIF_Qty = ```
			
			
			IF (SELECTEDVALUE(YrTable[Value])="2324",
			var _PerMarketResult = 
			SWITCH(
			    SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]),
			    "Gap_QL", SUM(OTIF[2324 GAP Qtls]),
			    "Gap_Euro", SUM(OTIF[2324 GAP Val]),
			    "Contrib%", [Contrb_OTIF],
			    "Gap_TUs", CALCULATE(SUM(OTIF[Gap Qty TU]),OTIF[Yr]="2324"),
			  [Contrb_OTIF])  -- default to ValueMeasure if no selection is made)
			
			var _TotalResult = 
			CALCULATE(
			SWITCH(
			    SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]),
			    "Gap_QL", SUM(OTIF[2324 GAP Qtls]),
			    "Gap_Euro", SUM(OTIF[2324 GAP Val]),
			    "Contrib%", [Contrb_OTIF],
			    "Gap_TUs", CALCULATE(SUM(OTIF[Gap Qty TU]),OTIF[Yr]="2324"),
			  [Contrb_OTIF])  -- default to ValueMeasure if no selection is made)
			,REMOVEFILTERS(Market))
			
			Return if (SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)", _PerMarketResult, _TotalResult),
			
			-------------------------------------- remaining years
			IF (SELECTEDVALUE(YrTable[Value])="2425",
			var _PerMarketResult = 
			SWITCH(
			    SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]),
			    "Gap_QL", CALCULATE(SUM(OTIF[ORDERQTY (KG)])/100,OTIF[Yr]="2425"),
			    "Gap_Euro", CALCULATE(SUM(OTIF[ORDERVALUE (EUR)]),OTIF[Yr]="2425"),
			    "Contrib%", [Contrb_OTIF],
			    "Gap_TUs", CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425"),
			  [Contrb_OTIF])  -- default to ValueMeasure if no selection is made)
			
			var _TotalResult = 
			CALCULATE(
			SWITCH(
			    SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]),
			    "Gap_QL", CALCULATE(SUM(OTIF[ORDERQTY (KG)])/100,OTIF[Yr]="2425"),
			    "Gap_Euro", CALCULATE(SUM(OTIF[ORDERVALUE (EUR)]),OTIF[Yr]="2425"),
			    "Contrib%", [Contrb_OTIF],
			    "Gap_TUs", CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425"),
			  [Contrb_OTIF])  -- default to ValueMeasure if no selection is made)
			,REMOVEFILTERS(Market))
			
			
			Return 
			if (SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)", _PerMarketResult, _TotalResult)
			
			))
			```
