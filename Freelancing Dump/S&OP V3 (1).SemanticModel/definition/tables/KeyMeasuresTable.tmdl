	measure Selected_Measure_Inv_FCST_GAP = ```
			
			IF (
			    SELECTEDVALUE(YrTable[Value]) = "2425",
			    
			    VAR _PerMarketResult =
			        SWITCH (
			            SELECTEDVALUE(Selection_Table_All_Option[Value]),
			            
			            "Volume_Qils", 
			                IFERROR(
			                    IF (
			                        [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Qils)]) - SUM('Daily Progress'[Actual Total Sales (Qils)])) >= 0,
			                        0,
			                        [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Qils)]) - SUM('Daily Progress'[Actual Total Sales (Qils)]))
			                    ),
			                    BLANK()
			                ),
			
			            "Value_Euro",1,
			                /*
			                IFERROR(
			                    IF (
			                        [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Euro)]) - SUM('Daily Progress'[Act Sales (Euro)])) >= 0,
			                        0,
			                        [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Euro)]) - SUM('Daily Progress'[Act Sales (Euro)]))
			                    ),
			                    BLANK()
			                ),
			                */
			            
			            "Value_Local",1,
			            /*
			                IFERROR(
			                    IF (
			                        [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Loc_Val)]) - SUM('Daily Progress'[Actual Sale MTD (Loc_Val)])) >= 0,
			                        0,
			                        [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Loc_Val)]) - SUM('Daily Progress'[Actual Sale MTD (Loc_Val)]))
			                    ),
			                    BLANK()
			                ),
			                */
			
			            "Quantity_TUs", 
			                IFERROR(
			                    IF (
			                        [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (TU)]) - SUM('Daily Progress'[Actual Total Sales (TU)])) >= 0,
			                        0,
			                        [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (TU)]) - SUM('Daily Progress'[Actual Total Sales (TU)]))
			                    ),
			                    BLANK()
			                )
			        )
			
			    VAR _TotalResult = 
			        CALCULATE (
			            SWITCH (
			                SELECTEDVALUE(Selection_Table_All_Option[Value]),
			                
			                "Volume_Qils", 
			                    IFERROR(
			                        IF (
			                            [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Qils)]) - SUM('Daily Progress'[Actual Total Sales (Qils)])) >= 0,
			                            0,
			                            [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Qils)]) - SUM('Daily Progress'[Actual Total Sales (Qils)]))
			                        ),
			                        BLANK()
			                    ),
			
			                "Value_Euro",1,
			                    /*
			                    IFERROR(
			                        IF (
			                            [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Euro)]) - SUM('Daily Progress'[Act Sales (Euro)])) >= 0,
			                            0,
			                            [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (Euro)]) - SUM('Daily Progress'[Act Sales (Euro)]))
			                        ),
			                        BLANK()
			                    ),
			                    */
			                
			                "Value_Local",0, -- there is no local val in gac
			
			                "Quantity_TUs", 
			                    IFERROR(
			                        IF (
			                            [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (TU)]) - SUM('Daily Progress'[Actual Total Sales (TU)])) >= 0,
			                            0,
			                            [Selected_Measure_Stock] - (SUM('Daily Progress'[Sales Plan (TU)]) - SUM('Daily Progress'[Actual Total Sales (TU)]))
			                        ),
			                        BLANK()
			                    )
			            ),
			            REMOVEFILTERS(Market)
			        )
			
			    RETURN 
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", _PerMarketResult, _TotalResult)
			)
			
			```
