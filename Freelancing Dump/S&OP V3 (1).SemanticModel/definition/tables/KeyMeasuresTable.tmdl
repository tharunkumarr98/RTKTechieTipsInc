	measure 'Selection_S.Bias_CY' = ```
			
			
			-- formula of Accuracy = MAX(IFERROR((1-((ABS(Proposed-Deployied)/Proposed))),0),0)
			--if (SELECTEDVALUE('Proposed Shipment'[Mon])<>SELECTEDVALUE(Month_Sort[Month_Number]), BLANK(), -- otherwise will calculate 1% for all future months
			
			If(
			    SELECTEDVALUE(Month_Sort[Month]) <> "YTD" && SELECTEDVALUE(Month_Sort[Month]) <> "LY",
			    IF (
			        SELECTEDVALUE('YrTable'[Value]) = "2425",
			        VAR _PerMarketResult = CALCULATE(DIVIDE(sum('Proposed Shipment'[Deployed]),sum('Proposed Shipment'[Proposed]),0), 'Proposed Shipment'[Mon]<12)
			        VAR _TotalResult = CALCULATE(DIVIDE(sum('Proposed Shipment'[Deployed]),sum('Proposed Shipment'[Proposed]),0),REMOVEFILTERS(Market), 'Proposed Shipment'[Mon]<12)
			        
			        RETURN IF(SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", _PerMarketResult, _TotalResult)
			        
			        /*RETURN 
			            IF(ISBLANK(Result) || ISERROR(Result),0,MAX(Result, 0))*/
			    )
			)
			
			
			```
		formatString: 0%;-0%;0%
