	measure Selection_MEP_CY = ```
			
			
			If(SELECTEDVALUE(Radio_Button_Option[Radio_Button_Option])= "Number of Docs",
			
			 
			 If (SELECTEDVALUE(Month_Sort[Month])<>"YTD" && SELECTEDVALUE(Month_Sort[Month])<>"LY",
			 
			 IF (SELECTEDVALUE(YrTable[Value])="2425",
			
			
			    Var _PerMarketResult=
			
			    /* To Test the Logic...
			    Numerator: Counts the unique deliveries made between the 21st day of the month and the end of that month for the year "2425".
			    Denominator: Counts the unique deliveries made from the 1st day of the month to the end of that month for the same year.
			    */
			    
			   DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), 'VL06O - DN'[Yr] = "2425"
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), 'VL06O - DN'[Yr] = "2425"
			    )
			)
			
			
			    Var _TotalResult=
			    
			      DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2425"
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2425"
			    )
			)
			
			    RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", _PerMarketResult,_TotalResult)),
			    
			    
			    --- below for YTD, LY Section
			
			 IF (SELECTEDVALUE(YrTable[Value])="2425",
			
			    Var _PerMarketResult=
			    
			   DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0),REMOVEFILTERS(Month_Sort), 'VL06O - DN'[Yr] = "2425"
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0),REMOVEFILTERS(Month_Sort), 'VL06O - DN'[Yr] = "2425"
			    )
			)
			
			
			    Var _TotalResult=
			    
			   
			   DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0),REMOVEFILTERS(Month_Sort),REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2425"
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0),REMOVEFILTERS(Market), REMOVEFILTERS(Month_Sort), 'VL06O - DN'[Yr] = "2425"
			    )
			   )
			
			    RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", _PerMarketResult,_TotalResult))),
			---------------------------------------------------------------------------------------------------------this is if selection by qtls
			
			If(SELECTEDVALUE(Radio_Button_Option[Radio_Button_Option])= "Volume_QL",
			
			 
			 If (SELECTEDVALUE(Month_Sort[Month])<>"YTD" && SELECTEDVALUE(Month_Sort[Month])<>"LY",
			 
			 IF (SELECTEDVALUE(YrTable[Value])="2425",
			
			
			    Var _PerMarketResult=
			    
			   DIVIDE(
			    CALCULATE(
			        SUM('VL06O - DN'[Net weight (KG)]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), 'VL06O - DN'[Yr] = "2425"
			    ),
			    CALCULATE(
			        SUM('VL06O - DN'[Net weight (KG)]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), 'VL06O - DN'[Yr] = "2425"
			    )
			)--/100
			
			
			    Var _TotalResult=
			    
			   
			   DIVIDE(
			    CALCULATE(
			        SUM('VL06O - DN'[Net weight (KG)]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0),REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2425"
			    ),
			    CALCULATE(
			        SUM('VL06O - DN'[Net weight (KG)]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2425"
			    )
			)--/100
			
			    RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", _PerMarketResult,_TotalResult)),
			    
			    
			    --- below for YTD, LY Section
			
			 IF (SELECTEDVALUE(YrTable[Value])="2425",
			
			    Var _PerMarketResult=
			    
			   DIVIDE(
			    CALCULATE(
			        SUM('VL06O - DN'[Net weight (KG)]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0),REMOVEFILTERS(Month_Sort), 'VL06O - DN'[Yr] = "2425"
			    ),
			    CALCULATE(
			        SUM('VL06O - DN'[Net weight (KG)]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0),REMOVEFILTERS(Month_Sort), 'VL06O - DN'[Yr] = "2425"
			    )
			)--/100
			
			
			    Var _TotalResult=
			    
			   
			   DIVIDE(
			    CALCULATE(
			        SUM('VL06O - DN'[Net weight (KG)]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0),REMOVEFILTERS(Month_Sort), REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2425"
			    ),
			    CALCULATE(
			        SUM('VL06O - DN'[Net weight (KG)]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), REMOVEFILTERS(Month_Sort),REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2425"
			    )
			)--/100
			
			    RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", _PerMarketResult,_TotalResult)))
			
			
			
			
			))
			```
