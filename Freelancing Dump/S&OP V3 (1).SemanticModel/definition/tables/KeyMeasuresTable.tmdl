	measure Selection_SA_CY_Old_As_Per_SFA = ```
			
			
			-- formula of Accuracy by sku level = MAX(IFERROR((1-((ABS(Proposed-Deployied)/Proposed))),0),0)
			--if (SELECTEDVALUE('Proposed Shipment'[Mon])<>SELECTEDVALUE(Month_Sort[Month_Number]), BLANK(), -- otherwise will calculate 1% for all future months
			-- grouped level formula = proposed * accuracy / proposed
			
			If(SELECTEDVALUE('YrTable'[Value]) = "2425",
			    
			    IF (SELECTEDVALUE(Month_Sort[Month]) <> "YTD" && SELECTEDVALUE(Month_Sort[Month]) <> "LY",
			        
			        VAR _PerMarketResult = --below sfa formula
			        
			        VAR RESULT = 
			        CALCULATE(     
			        100 - IF (
			                SUM('Shipment Acc'[AbsDelta]) >= SUM('Shipment Acc'[Proposed]),100,
			                (SUM('Shipment Acc'[AbsDelta]) / SUM('Shipment Acc'[Proposed]))* 100
			            )) 
			        RETURN
			        IF(Result = 0, BLANK(), Result)
			
			        VAR _TotalResult = 
			        VAR RESULT = 
			
			        CALCULATE(     
			        100 - IF (
			                SUM('Shipment Acc'[AbsDelta]) >= SUM('Shipment Acc'[Proposed]),100,
			                SUM('Shipment Acc'[AbsDelta]) / SUM('Shipment Acc'[Proposed]) * 100)
			            , REMOVEFILTERS(Market))
			        RETURN
			        IF(Result = 0, BLANK(), Result)
			
			        RETURN IF(SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)",_PerMarketResult,_TotalResult),
			
			
			        ----------------------------------this is if YTD LY
			
			        VAR _PerMarketResult = 
			        
			        CALCULATE(     
			        100 - IF (
			                SUM('Shipment Acc'[AbsDelta]) >= SUM('Shipment Acc'[Proposed]),100,
			                SUM('Shipment Acc'[AbsDelta]) / SUM('Shipment Acc'[Proposed]) * 100
			            ), REMOVEFILTERS(Month_Sort)) 
			
			        VAR _TotalResult = 
			        
			        CALCULATE(     
			        100 - IF (
			                SUM('Shipment Acc'[AbsDelta]) >= SUM('Shipment Acc'[Proposed]),100,
			                SUM('Shipment Acc'[AbsDelta]) / SUM('Shipment Acc'[Proposed]) * 100
			            ), REMOVEFILTERS(Market), REMOVEFILTERS(Month_Sort)) 
			        --RETURN IF(_TotalResult = 0, BLANK(), _TotalResult)
			
			        RETURN if(IF(SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)",_PerMarketResult,_TotalResult)=0,BLANK(),IF(SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)",_PerMarketResult,_TotalResult))))
			
			
			```
		formatString: 0.0
		lineageTag: 5b4a1ab1-f54c-4f80-80f1-5325aa01d46d

