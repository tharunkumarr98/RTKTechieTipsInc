	measure Selected_Measure_Aging = ```
			
			
			
			IF (SELECTEDVALUE(YrTable[Value])="2425",
			var _PerMarketResult = 
			SWITCH(
			    SELECTEDVALUE(Selection_Table_All_Option[Value]),
			    "Volume_Qils", 1, -- we don't have SUM('Daily Progress'[Aging stocks (Qils)]),
			    "Value_Euro", 1, -- we don't have SUM('Daily Progress'[Aging stocks (Euro)]),
			    "Value_Local", 1, -- we don't have SUM('Daily Progress'[Aging stocks (Loc_Val)]),
			    "Quantity_TUs", SUM('Daily Progress'[Aging stocks (TU)]))
			
			var _TotalResult = 
			CALCULATE(
			SWITCH(
			    SELECTEDVALUE(Selection_Table_All_Option[Value]),
			    "Volume_Qils", 1, -- we don't have SUM('Daily Progress'[Aging stocks (Qils)]),
			    "Value_Euro", 1, -- we don't haveSUM('Daily Progress'[Aging stocks (Euro)]),
			    "Value_Local", 1, -- we don't haveSUM('Daily Progress'[Aging stocks (Loc_Val)]),
			    "Quantity_TUs", SUM('Daily Progress'[Aging stocks (TU)]))
			,REMOVEFILTERS(Market))
			
			Return if (SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)", _PerMarketResult, _TotalResult)
			
			)
			```
		lineageTag: a34baa75-a66a-46a9-8ce8-3ff5cb34baf4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Selected_Measure_Inv_OTIF_GAP = ```
			
			IF (
			    SELECTEDVALUE(YrTable[Value]) = "2425",
			    
			    VAR _PerMarketResult = 
			        SWITCH (
			            SELECTEDVALUE(Selection_Table_All_Option[Value]),
			            
			            "Volume_Qils", 
			                IF (
			                    SUM('Daily Progress'[Stock as of Date (Qils)]) - SUM('Central Order Monitor'[Open Qty (Qtls)]) >= 0,
			                    0,
			                    SUM('Daily Progress'[Stock as of Date (Qils)]) - SUM('Central Order Monitor'[Open Qty (Qtls)])
			                ),
			
			            "Value_Euro", 
			                1,  // Placeholder 
			
			            "Value_Local", 
			                1,  // Placeholder 
			
			            "Quantity_TUs", 
			                IF (
			                    SUM('Daily Progress'[Stock as of Date (TU)]) - SUM('Central Order Monitor'[  OPENQTY (TU)]) >= 0,
			                    0,
			                    SUM('Daily Progress'[Stock as of Date (TU)]) - SUM('Central Order Monitor'[  OPENQTY (TU)])
			                )
			        )
			    
			    VAR _TotalResult = 
			        CALCULATE (
			            SWITCH (
			                SELECTEDVALUE(Selection_Table_All_Option[Value]),
			                
			                "Volume_Qils", 
			                    IF (
			                        SUM('Daily Progress'[Stock as of Date (Qils)]) - SUM('Central Order Monitor'[Open Qty (Qtls)]) >= 0,
			                        0,
			                        SUM('Daily Progress'[Stock as of Date (Qils)]) - SUM('Central Order Monitor'[Open Qty (Qtls)])
			                    ),
			
			                "Value_Euro", 
			                    1,  -- Placeholder 
			                "Value_Local", 
			                    1,  -- Placeholder 
			
			                "Quantity_TUs", 
			                    IF (
			                        SUM('Daily Progress'[Stock as of Date (TU)]) - SUM('Central Order Monitor'[  OPENQTY (TU)]) >= 0,
			                        0,
			                        SUM('Daily Progress'[Stock as of Date (TU)]) - SUM('Central Order Monitor'[  OPENQTY (TU)])
			                    )
			            ),
			            REMOVEFILTERS(Market)
			        )
			
			    RETURN 
			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", _PerMarketResult, _TotalResult)
			)
			
			```
		formatString: 0.00
		lineageTag: c33df2a0-f49b-4009-9a6d-9b2d15e6d887

	measure Selection_MEP_LY = ```
			
			
			If(SELECTEDVALUE(Radio_Button_Option[Radio_Button_Option])= "Number of Docs",
			
			 
			 If (SELECTEDVALUE(Month_Sort[Month])<>"YTD" && SELECTEDVALUE(Month_Sort[Month])<>"LY",
			 
			 IF (SELECTEDVALUE(YrTable[Value])="2425",
			
			
			    Var _PerMarketResult=
			    
			   DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), 'VL06O - DN'[Yr] = "2324"
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), 'VL06O - DN'[Yr] = "2324"
			    )
			)
			
			
			    Var _TotalResult=
			    
			      DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 21, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2324"
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
			        'VL06O - DN'[Act. Gds Mvmnt Date] >= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], -1) + 1, 
			        'VL06O - DN'[Act. Gds Mvmnt Date] <= EOMONTH('VL06O - DN'[Act. Gds Mvmnt Date], 0), REMOVEFILTERS(Market), 'VL06O - DN'[Yr] = "2324"
			    )
			)
			
			    RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", _PerMarketResult,_TotalResult)),
			    
			    
			    --- below for YTD, LY Section
			
			 IF (SELECTEDVALUE(YrTable[Value])="2425",
			
			    Var _PerMarketResult=
			    
			   DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('VL06O - DN'[Delivery]),
