	measure Selection_Ret_CY_BW = ```
			
			
			if (SELECTEDVALUE(YrTable[Value])="2425",
			if (SELECTEDVALUE(Month_Sort[Month])<>"YTD" && SELECTEDVALUE(Month_Sort[Month])<>"LY",
			
			    var _PerMarketResult= -- REVERSAL
			        DIVIDE(    
			        CALCULATE(SUM('Returns and Refusals'[RETURN BILLED AMOUNT (EUR)]), 'Returns and Refusals'[T-Actual GI Date] >= DATE(2024, 9, 1),'Returns and Refusals'[T-Actual GI Date] <= DATE(2025, 8, 31))
			    ,
			        CALCULATE(sum('Gross Data'[GROSS1_Eur]), 'Gross Data'[Billing Date]>= DATE(2024, 9, 1),'Gross Data'[Billing Date] <= DATE(2025, 8, 31)
			    ))*-100
			
			    var _TotalResult=
			        CALCULATE(
			        DIVIDE(    
			        CALCULATE(SUM('Returns and Refusals'[RETURN BILLED AMOUNT (EUR)]), 'Returns and Refusals'[T-Actual GI Date] >= DATE(2024, 9, 1),'Returns and Refusals'[T-Document Date]<= DATE(2025, 8, 31))
			    ,
			        CALCULATE(sum('Gross Data'[GROSS1_Eur]), 'Gross Data'[Billing Date]>= DATE(2024, 9, 1),'Gross Data'[Billing Date] <= DATE(2025, 8, 31)
			    )), REMOVEFILTERS(Market))*-100
			
			    RETURN if (SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)",_PerMarketResult,_TotalResult),
			
			var _PerMarketResult=
			    
			    CALCULATE(
			        DIVIDE(    
			        CALCULATE(SUM('Returns and Refusals'[RETURN BILLED AMOUNT (EUR)]), 'Returns and Refusals'[T-Actual GI Date] >= DATE(2024, 9, 1),'Returns and Refusals'[T-Actual GI Date]<= DATE(2025, 8, 31))
			    ,
			        CALCULATE(sum('Gross Data'[GROSS1_Eur]), 'Gross Data'[Billing Date]>= DATE(2024, 9, 1),'Gross Data'[Billing Date] <= DATE(2025, 8, 31)
			    )),REMOVEFILTERS(Month_Sort))*-100
			
			    var _TotalResult=
			        CALCULATE(
			        DIVIDE(    
			        CALCULATE(SUM('Returns and Refusals'[RETURN BILLED AMOUNT (EUR)]), 'Returns and Refusals'[T-Actual GI Date] >= DATE(2024, 9, 1), 'Returns and Refusals'[T-Actual GI Date] <= DATE(2025, 8, 31))
			    ,
			        CALCULATE(sum('Gross Data'[GROSS1_Eur]), 'Gross Data'[Billing Date]>= DATE(2024, 9, 1),'Gross Data'[Billing Date] <= DATE(2025, 8, 31)
			    )), REMOVEFILTERS(Market),REMOVEFILTERS(Month_Sort))*-100
			
			    RETURN if (SELECTEDVALUE(Market[Market (Key)])<>"GAC (Gulf)",_PerMarketResult,_TotalResult) -- document date
			
			)
			
			)--))
			```
		formatString: 0.0
		lineageTag: 816e77be-b931-4b14-aca8-b90144985b40

