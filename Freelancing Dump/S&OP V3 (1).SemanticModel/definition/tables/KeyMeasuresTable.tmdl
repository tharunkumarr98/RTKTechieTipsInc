			    SUMX(Market_Level_Cvg, Market_Level_Cvg[cvg w+1] * Market_Level_Cvg[cvg]),
			    SUM(Market_Level_Cvg[cvg w+1])), Market_Level_Cvg[Yr]="2425")
			
