	measure Desc_04 = ```
			
			VAR SelectedMarket = SELECTEDVALUE(Market[Market (Key)], "No Market Selected")
			RETURN
			IF(
			    SelectedMarket = "GAC (Gulf)",
			    CONCATENATEX(
			        VALUES(SFA_Comment[Clean Name]),
			        SFA_Comment[Clean Name],
			        UNICHAR(10)  // New line character for better readability
			    ),
			    CONCATENATEX(
			        FILTER(
			            SFA_Comment,
			            SFA_Comment[APO Location] = SelectedMarket
			        ),
			        SFA_Comment[Clean Name],
			        UNICHAR(10)  // New line character for better readability
			    )
			)
			
			
			
			```
