			        IF (SELECTEDVALUE(Market[Market (Key)]) <> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (combined)] = Top_6_Reason,OTIF[D-On-Time vs CDD] <>"On Time",OTIF[Yr]="2425"),CALCULATE(SUM(OTIF[ORDERQTY (TU)]),OTIF[Yr]="2425")) * 100,
			        --this is for gac
			        -1 * DIVIDE(CALCULATE(SUM(OTIF[ORDERQTY (TU)]), OTIF[Breakdown (combined)] = Top_6_Reason,OTIF[D-On-Time vs CDD] <>"On Time", REMOVEFILTERS(Market),OTIF[Yr]="2425"), CALCULATE(SUM(OTIF[ORDERQTY (TU)]), REMOVEFILTERS(Market),OTIF[Yr]="2425"))*100),
			        --this is for other types of calculations
			                
			        CALCULATE(-1 * [Selected_Measure_OTIF], OTIF[Breakdown (combined)] = Top_6_Reason,OTIF[D-On-Time vs CDD] <>"On Time")))))))))),
			        
			        ---------------------------------------------------------------------------------------------------------
			        if (SELECTEDVALUE(OTIF_Parameter[OTIF_Parameter Order])=2,
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Total", 
			
			         if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)",  DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)])),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE( DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)])),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE([OTIF_Total_Bucket],REMOVEFILTERS(OTIF[D-RC Cluster]))),
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Supply Chain",
			
			        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Supply Chain"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Supply Chain"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			        
			        CALCULATE(-1 * [Selected_Measure_OTIF],OTIF[D-RC Cluster]="Supply Chain")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Commercial", --Commercial
			
			
			        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Commercial"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Commercial"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			                
			        CALCULATE(-1 * [Selected_Measure_OTIF],OTIF[D-RC Cluster]="Commercial")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "IT", 
			
			        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="IT"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="IT"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF],OTIF[D-RC Cluster]="IT")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Forecast", 
			
			        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Forecast"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Forecast"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF],OTIF[D-RC Cluster]="Forecast")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Industrial", 
			
			                if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Industrial"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Industrial"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF],OTIF[D-RC Cluster]="Industrial")),
			
			                IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Not Assigned", --HERE IS LIKE OTHERS
			
			                if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Not Assigned",OTIF[D-On-Time vs CDD] <> "On Time"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Not Assigned",OTIF[D-On-Time vs CDD] <> "On Time"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF],OTIF[D-RC Cluster]="Not Assigned",OTIF[D-On-Time vs CDD] <> "On Time")),
			
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Contingency", 
			
			                if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Contingency"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Contingency"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			        
			        CALCULATE(-1 * [Selected_Measure_OTIF],OTIF[D-RC Cluster]="Contingency")),
			
			        
			        IF (SELECTEDVALUE(Waterfall_OTIF[By Ownership]) = "Project Delay", 
			
			                        if(SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option])="Contrib%",
			        if( SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)", -1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Project Delay"),sum(OTIF[ORDERQTY (TU)]))*100, CALCULATE(-1 * DIVIDE(CALCULATE(sum(OTIF[ORDERQTY (TU)]),OTIF[D-RC Cluster]="Project Delay"),sum(OTIF[ORDERQTY (TU)]))*100,REMOVEFILTERS(Market))), --below is for other calculation options
			
			        CALCULATE(-1 * [Selected_Measure_OTIF],OTIF[D-RC Cluster]="Project Delay")
			        
			        )))))))))))))--))*/
