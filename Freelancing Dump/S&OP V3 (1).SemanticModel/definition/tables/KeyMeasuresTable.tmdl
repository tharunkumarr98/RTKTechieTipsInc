			if ( SELECTEDVALUE('AccessValues#4'[Access]) = "CY M-1",CALCULATE(SUM('STD S&OP NY (2526)'[FY]),'STD S&OP NY (2526)'[Week]="24.2025"), 
			if ( SELECTEDVALUE('AccessValues#4'[Access]) = "CY M0",CALCULATE(SUM('STD S&OP NY (2526)'[FY]),'STD S&OP NY (2526)'[Week]="28.2025"),
			if ( SELECTEDVALUE('AccessValues#4'[Access]) = "Budget",CALCULATE(SUM('STD BDGT'[FY])),
			if ( SELECTEDVALUE('AccessValues#4'[Access]) = "LY",CALCULATE(SUM('STD S&OP LY (2425)'[FY]))
			
			))))
			
			VAR _TotalResult= 
			if ( SELECTEDVALUE('AccessValues#4'[Access]) = "CY M-1",CALCULATE(SUM('STD S&OP NY (2526)'[FY]),'STD S&OP NY (2526)'[Week]="24.2025",REMOVEFILTERS(Market)), 
			if ( SELECTEDVALUE('AccessValues#4'[Access]) = "CY M0",CALCULATE(SUM('STD S&OP NY (2526)'[FY]),'STD S&OP NY (2526)'[Week]="28.2025",REMOVEFILTERS(Market)),
			if ( SELECTEDVALUE('AccessValues#4'[Access]) = "Budget",CALCULATE(SUM('STD BDGT'[FY]),REMOVEFILTERS(Market)),
			if ( SELECTEDVALUE('AccessValues#4'[Access]) = "LY",CALCULATE(SUM('STD S&OP LY (2425)'[FY]),REMOVEFILTERS(Market))
			))))
			
			
			
			RETURN if (SELECTEDVALUE(Market[Market (Key)])<> "GAC (Gulf)",_PerMarketResult, _TotalResult)
			
			```
		lineageTag: e46d73d8-07af-408a-ba97-b1d6d2028ff3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Bias mid Line' = ```
			
			Var MaxValue = MAXX(VALUES('SFA Folder'[SKU]), [Bias F4 and O4])
			Var MinValue = MinX(VALUES('SFA Folder'[SKU]), [Bias F4 and O4])
			Var MidPoint = (MaxValue + MinValue)/2
			RETURN MidPoint 
			
			```
