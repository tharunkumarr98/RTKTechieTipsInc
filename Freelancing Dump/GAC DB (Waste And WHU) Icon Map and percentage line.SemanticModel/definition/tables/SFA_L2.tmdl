	measure SFA_Tgt_001 =
			
			VAR SelectedRegion = SELECTEDVALUE('market'[market (key)])
			RETURN
			CALCULATE(
			    SUM(Targets_GAC_Main[TGT])*100,
			    FILTER(Targets_GAC_Main, Targets_GAC_Main[Market] = SelectedRegion && Targets_GAC_Main[KPI]="1001"
			))
		formatString: 0
		lineageTag: f092a63a-be1a-4d09-8aec-6363dff7d6c4

		annotation PBI_FormatHint = {"isDecimal":true}

