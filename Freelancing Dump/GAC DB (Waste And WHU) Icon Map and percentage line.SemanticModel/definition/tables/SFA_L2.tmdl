	measure YTD_SFA_001 = ```
			
			if  (SELECTEDVALUE (Month_Sort[Month]) = "YTD",
			VAR SelectedRegion = SELECTEDVALUE('market'[market (key)])
			RETURN
			CALCULATE(
			    SUM('YTD_SFA'[CY SFA 001]),
			    FILTER('YTD_SFA', 'YTD_SFA'[G-Sales District (Ship-To)] = SelectedRegion)
			))
			
			
			```
