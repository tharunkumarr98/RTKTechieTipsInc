	measure CFR_22/23_TU =
			
			
			IF( SELECTEDVALUE(MONTH_SORT[Month]) <> "YTD" && SELECTEDVALUE(MONTH_SORT[Month]) <> "LY",
			    --MIN('CFR'[Requested deliv.date]) > DATE(2023, 8, 31) || MAX('CFR'[Requested deliv.date]) < DATE(2022, 9, 1),
			    --BLANK(),
			    DIVIDE(
			        CALCULATE(
			            SUM('CFR'[TU billed]),
			            FILTER(
			                'CFR',
			                'CFR'[Requested deliv.date] >= MAX(DATE(2022, 9, 1), MIN('CFR'[Requested deliv.date])) &&
			                'CFR'[Requested deliv.date] <= MIN(DATE(2023, 8, 31), MAX('CFR'[Requested deliv.date]))
			            )
			        ),
			        CALCULATE(
			            SUM('CFR'[Order Quantity])-SUM(CFR[Open Order Quantity]),
			            FILTER(
			                'CFR',
			                'CFR'[Requested deliv.date] >= MAX(DATE(2022, 9, 1), MIN('CFR'[Requested deliv.date])) &&
			                'CFR'[Requested deliv.date] <= MIN(DATE(2023, 8, 31), MAX('CFR'[Requested deliv.date]))
			            )
			        )
			    ),BLANK()
			)
		formatString: 0%;-0%;0%
		lineageTag: b426a0f6-bc7a-4157-a770-52e948ba98a6

