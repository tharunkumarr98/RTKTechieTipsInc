	measure CFR_Sign = IF(CFR[SL%_23/24] > sum(Targets_GAC_Main[tgt]), "Good", "Bad")
		lineageTag: 5dda1800-58d0-44e4-ba89-d242886561b1

	measure SL%_22/23 = ```
			
			IF(
			    MIN('CFR'[Requested deliv.date]) > DATE(2023, 8, 31) || MAX('CFR'[Requested deliv.date]) < DATE(2022, 9, 1),
			    BLANK(),
			    DIVIDE(
			        CALCULATE(
			            SUM('CFR'[Delivery Item Gross Amount]),
			            FILTER(
			                'CFR',
			                'CFR'[Requested deliv.date] >= MAX(DATE(2022, 9, 1), MIN('CFR'[Requested deliv.date])) &&
			                'CFR'[Requested deliv.date] <= MIN(DATE(2023, 8, 31), MAX('CFR'[Requested deliv.date]))
			            )
			        ),
			        CALCULATE(
			            SUM('CFR'[Order Item Gross Amount]),
			            FILTER(
			                'CFR',
			                'CFR'[Requested deliv.date] >= MAX(DATE(2022, 9, 1), MIN('CFR'[Requested deliv.date])) &&
			                'CFR'[Requested deliv.date] <= MIN(DATE(2023, 8, 31), MAX('CFR'[Requested deliv.date]))
			            )
			        )
			    )
			)
			
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 72658811-ba51-4091-a8ee-5c1ea1d8e759

	measure SL%_Total_YTD = ```
			
			 if (SELECTEDVALUE(month_sort[month])="YTD"
			 ,
			DIVIDE(    
			 CALCULATE( SUM( 'CFR'[Delivery Item Gross Amount])
			,'CFR'[Requested deliv.date] >= DATE(2023, 9, 1)
			,'CFR'[Requested deliv.date] <= DATE(2024, 8, 31)
			,REMOVEFILTERS(month_sort)
			 
			 )
			 ,
			
			 CALCULATE( SUM( 'CFR'[Order Item Gross Amount])  
			,'CFR'[Requested deliv.date] >= DATE(2023, 9, 1)
			,'CFR'[Requested deliv.date] <= DATE(2024, 8, 31)
			,REMOVEFILTERS(month_sort)
			
			            
			) )             
			 ,BLANK()
			 )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8f01c8d9-7c17-44ef-8880-edf12cfe4ebc

	measure SL%_Total_LY = ```
			
			IF (
			   SELECTEDVALUE(Month_Sort[Month]) = "LY",
			 
			DIVIDE(    
			 CALCULATE( SUM( 'CFR'[Delivery Item Gross Amount]),
			 'CFR'[Requested deliv.date] >= DATE(2022, 9, 1),
			 'CFR'[Requested deliv.date] <= DATE(2023, 8, 31)
			,REMOVEFILTERS(month_sort)
			 
			 )
			 ,
			
			 CALCULATE( SUM( 'CFR'[Order Item Gross Amount]),
			 'CFR'[Requested deliv.date] >= DATE(2022, 9, 1),
			 'CFR'[Requested deliv.date] <= DATE(2023, 8, 31)
			,REMOVEFILTERS(month_sort)
			
			            
			) )             
			 ,BLANK()
			 )
			
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0a11b784-fb00-41a0-9c44-0ea5b7514338

	measure CFR_Tgt = ```
			VAR SelectedRegion = SELECTEDVALUE('market'[market (key)])
			RETURN
			CALCULATE(
			    SUM(Targets_GAC_Main[TGT]),
			    FILTER(Targets_GAC_Main, Targets_GAC_Main[Market] = SelectedRegion && Targets_GAC_Main[KPI]="CFR"
			)) 
			```
		formatString: 0%;-0%;0%
		lineageTag: b0c27a3b-bd55-43f2-a51b-d366949e3d2a

	measure TestCFR =
			
			CALCULATE(DIVIDE(
				SUM('CFR'[Delivery Item Gross Amount]),
				SUM('CFR'[Order Item Gross Amount])
			),REMOVEFILTERS(Month_Sort[Month]))
		lineageTag: a3017bba-8c7e-40bc-8f79-9f1328f1fe0c

