table CFR
	lineageTag: 38ae948c-a46a-4419-8785-ad9d1bda0e65

	measure SL%_23/24 = ```
			
			IF(
			    MIN('CFR'[Requested deliv.date]) > DATE(2024, 8, 31) || MAX('CFR'[Requested deliv.date]) < DATE(2023, 9, 1),
			    BLANK(),
			    DIVIDE(
			        CALCULATE(
			            SUM('CFR'[Delivery Item Gross Amount]),
			            FILTER(
			                'CFR',
			                'CFR'[Requested deliv.date] >= MAX(DATE(2023, 9, 1), MIN('CFR'[Requested deliv.date])) &&
			                'CFR'[Requested deliv.date] <= MIN(DATE(2024, 8, 31), MAX('CFR'[Requested deliv.date]))
			            )
			        ),
			        CALCULATE(
			            SUM('CFR'[Order Item Gross Amount]),
			            FILTER(
			                'CFR',
			                'CFR'[Requested deliv.date] >= MAX(DATE(2023, 9, 1), MIN('CFR'[Requested deliv.date])) &&
			                'CFR'[Requested deliv.date] <= MIN(DATE(2024, 8, 31), MAX('CFR'[Requested deliv.date]))
			            )
			        )
			    )
			)
			
			
			```
		formatString: 0%;-0%;0%
		lineageTag: b9b07765-c39c-4732-be1c-700107206306

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure Formatted_Gap_Value = ```
			
			VAR formatedvalue = SUM([Gap Value])  -- Or another appropriate aggregation function
			RETURN 
			IF (
			    formatedvalue < 0,
			    "(" & FORMAT(ABS(formatedvalue), "#,##0.0") & ")",
			    FORMAT(formatedvalue, "#,##0.0")
			)
			
			```
		lineageTag: 738e2974-8d9c-4fc2-b38b-3895318fc0b9

	measure CFR_Contrb_Measure = ```
			
			VAR TotalValue = SUM(CFR[GAP Value])
			VAR TotalValueAllSelected = 
			    CALCULATE(
			        SUM(CFR[GAP Value]),
			        ALLSELECTED()
			    )
			RETURN 
			DIVIDE(
			    TotalValue, 
			    TotalValueAllSelected, 
			    0
			) * 100
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6bb2532c-8ad2-4feb-b312-c85c5519d709

	measure CFR_Selected_Measure = ```
			
			SWITCH(
			    SELECTEDVALUE(Radio_Button_Options_CFR[Radio_Button_Option]),
			    "Volume_QL", SUM(CFR[Gap QTL]),
			    "Value_Euro", SUM(CFR[Gap_Euro]),
			    "Contrib%", [CFR_Contrb_Measure],
			    "TUs", sum(CFR[tu Gap Open -Confir]),
			    --"CFR by TU", 
			    --IF(
			    --  SELECTEDVALUE(Month_Sort[Month]) = "YTD",
			    --[CFR_Total_YTD_TU],
			    --IF(
			    --    SELECTEDVALUE(Month_Sort[Month]) = "LY",
			    --    [CFR_Total_LY_TU],
			    --    IF(
			    --        AND(
			    --            SELECTEDVALUE(Month_Sort[Month]) <> "YTD",
			    --            SELECTEDVALUE(Month_Sort[Month]) <> "LY"
			    --        ),
			    --        [CFR_23/24_TU], -- & [CFR_22/23_TU],
			    --        BLANK()
			    --    )
			    --)
			    --)
			    --,
			    --    "CFR BW", SUM(CFR_BW[CASE FILL RATE 23/24]),
			  SUM(CFR[Gap_Euro])  -- default to ValueMeasure if no selection is made
			)
			
			```
		formatString: #,0.0
		lineageTag: 7017f9f4-ddfa-46a8-974f-41d10d4fe4a0

	measure Denominator = sum(CFR[GAP Value])
		lineageTag: fb51a703-59ea-4bea-8822-6cbdb6811670

