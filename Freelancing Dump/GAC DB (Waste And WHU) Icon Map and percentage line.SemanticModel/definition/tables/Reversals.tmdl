			        CALCULATE(
			            SUM('Gross Data'[GROSS1]),
			            FILTER(
			                'Gross Data',
			                'Gross Data'[Billing Date] >= MAX(DATE(2022, 9, 1), MIN('Gross Data'[Billing Date])) &&
			                'Gross Data'[Billing Date] <= MIN(DATE(2023, 8, 31), MAX('Gross Data'[Billing Date]))
			            )
			        )
			    )
			        
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2cb732bc-f1f0-4db3-ad98-27065e05197a

	measure Refusal_Tgt =
			VAR SelectedRegion = SELECTEDVALUE('market'[market (key)])
			RETURN
			CALCULATE(
			    SUM(Targets_GAC_Main[TGT])*100,
			    FILTER(Targets_GAC_Main, Targets_GAC_Main[Market] = SelectedRegion && Targets_GAC_Main[KPI]="Refusal %Order"
			))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 095f260f-1f05-45a8-af5d-db0bfeae590b

	measure Return_Tgt =
			VAR SelectedRegion = SELECTEDVALUE('market'[market (key)])
			RETURN
			CALCULATE(
			    SUM(Targets_GAC_Main[TGT]),
			    FILTER(Targets_GAC_Main, Targets_GAC_Main[Market] = SelectedRegion && Targets_GAC_Main[KPI]="Returns %GS"
			))
		lineageTag: 8d87cd4e-8cba-4965-b261-f6703204d548

