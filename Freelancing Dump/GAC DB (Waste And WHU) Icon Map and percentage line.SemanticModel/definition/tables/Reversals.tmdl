			    DIVIDE(
			        CALCULATE(
			            SUM(Reversals[Invoice Gross Amount]),
			            FILTER(
			                'Reversals',
			                'Reversals'[Created On_2] >= MAX(DATE(2022, 9, 1), MIN('Reversals'[Created On_2])) &&
