	measure Reversal_Sign = if (Reversals[Refusal% CY] > sum(Targets_GAC_Main[tgt]), "Bad", if (Reversals[Return 23/24] = sum(Targets_GAC_Main[tgt]), "Med","Good"))
		lineageTag: 9cff763e-9146-4131-b185-629d7de6d96c

	measure Refusal_Contrb_Measure = ```
			
			VAR TotalValue = DISTINCTCOUNT(Reversals[Sales Document])
			VAR TotalValueAllSelected = 
			    CALCULATE(
			        DISTINCTCOUNT(Reversals[Sales Document]),
			        ALLSELECTED()
			    )
			RETURN 
			DIVIDE(
			    TotalValue, 
			    TotalValueAllSelected, 
			    0
			) * 100
			```
		lineageTag: 561effb2-018d-4a70-8814-15ed55d6d592

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Return_Contrb_Measure = ```
			
			VAR TotalValue = SUM(Reversals[Invoice Gross Amount])
			VAR TotalValueAllSelected = 
			    CALCULATE(
			        SUM(Reversals[Invoice Gross Amount]),
			        ALLSELECTED()
			    )
			RETURN 
			DIVIDE(
			    TotalValue, 
			    TotalValueAllSelected, 
			    0
			) * 100
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dc73d6f6-1537-435e-95a1-76f19df70e75

	measure Refusal%_Total = ```
			
			IF (SELECTEDVALUE ( Month_Sort[Month] ) = "YTD", 
			
			DIVIDE(    
			CALCULATE( DISTINCTCOUNT( Reversals[Billing Document]),
			Reversals[Created On_2] >= DATE(2023, 9, 1),
			Reversals[Created On_2] <= DATE(2024, 8, 31),
			REMOVEFILTERS(month_sort))
			
			,
			
			CALCULATE( DISTINCTCOUNT('Gross Data'[Bill.Doc.] ),
			'Gross Data'[Billing Date] >= DATE(2023, 9, 1),
			'Gross Data'[Billing Date] <= DATE(2024, 8, 31),
			REMOVEFILTERS(month_sort)) 
			),
			
			if(SELECTEDVALUE ( Month_Sort[Month] ) = "LY",
			DIVIDE(    
			CALCULATE( DISTINCTCOUNT( Reversals[Billing Document]),
			Reversals[Created On_2] >= DATE(2022, 9, 1),
			Reversals[Created On_2] <= DATE(2023, 8, 31),
			REMOVEFILTERS(month_sort))
			,
			CALCULATE( DISTINCTCOUNT('Gross Data'[Bill.Doc.] ),
			'Gross Data'[Billing Date] >= DATE(2022, 9, 1),
			'Gross Data'[Billing Date] <= DATE(2023, 8, 31),
			REMOVEFILTERS(month_sort)) 
			),BLANK()))
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4d52fb2d-11a6-42e7-b55b-2a3ff91e1e31

	measure Return_Sign = if (Reversals[Delta vs. LY]<0,"Good", IF(Reversals[Delta vs. LY]=0.00,"Med","Bad"))
		lineageTag: e1ae3197-97ee-4f63-ba96-09fece2624b4

	measure 'Refusal% CY' = ```
			
