	measure Selection_Refusal = ```
			
			     SWITCH(
			         SELECTEDVALUE(Reversal_Selection_Table[Value]),
			         "Volume_QL", SUM(Reversals[Invoice Item Net QLY]),
			         "Value_Local", sum(Reversals[Invoice Gross Amount]),
			         "Count_DNs", DISTINCTCOUNT(Reversals[Billing Document]),
			         "Contribution %", [Refusal_Contrb_Measure],
			         sum(Reversals[Invoice Gross Amount])  -- default to ValueMeasure if no selection is made
			     )
