	measure 'Delta vs. LY' =
			
			VAR BASELINE_VALUE = [Return% 22/23]
			VAR VALUE_TO_COMPARE = [Return 23/24]
			RETURN
				IF(
					NOT ISBLANK(VALUE_TO_COMPARE),
					VALUE_TO_COMPARE - BASELINE_VALUE
				)
